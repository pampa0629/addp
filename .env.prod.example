# =============================================================================
# ADDP Production Environment Configuration Template
# =============================================================================
# Description: Production environment variables for ADDP deployment
# Usage: Copy to .env.prod and configure with actual values
# Note: Sensitive keys will be auto-generated by 3-server-setup.sh
# =============================================================================

# ==================== Security Keys (Auto-Generated) ====================
# These will be automatically generated during server setup
# DO NOT manually edit these in production

JWT_SECRET=WILL_BE_GENERATED_ON_SETUP
ENCRYPTION_KEY=WILL_BE_GENERATED_ON_SETUP
INTERNAL_API_KEY=WILL_BE_GENERATED_ON_SETUP

# ==================== Super Admin Configuration ====================
# Default super admin account (created on first startup)
# WARNING: Change the password immediately after first login!

SUPER_ADMIN_USERNAME=SuperAdmin
SUPER_ADMIN_PASSWORD=20251001#SuperAdmin
SUPER_ADMIN_EMAIL=admin@addp.local

# ==================== Default Tenant Configuration ====================
# ⚠️ Production environments MUST NOT enable default tenant creation
# ⚠️ This feature is for development/testing ONLY
# DO NOT set ENABLE_DEFAULT_TENANT=true in production
# The application will enforce this restriction regardless of configuration

# ENABLE_DEFAULT_TENANT=false  # Do not enable this option in production

# ==================== Database Configuration ====================

POSTGRES_USER=addp
POSTGRES_PASSWORD=WILL_BE_GENERATED_ON_SETUP
POSTGRES_DB=addp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==================== Redis Configuration ====================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=WILL_BE_GENERATED_ON_SETUP

# ==================== MinIO Configuration (System) ====================
# System MinIO for ADDP internal files (avatars, configs, etc.)

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=WILL_BE_GENERATED_ON_SETUP
MINIO_ENDPOINT=minio-system:9000
MINIO_BUCKET=addp-system

# ==================== MinIO Configuration (Business) ====================
# Business MinIO for user data (deployed separately in business/)

BUSINESS_MINIO_ENDPOINT=host.docker.internal:9002
BUSINESS_MINIO_ACCESS_KEY=minioadmin
BUSINESS_MINIO_SECRET_KEY=WILL_BE_GENERATED_ON_SETUP

# ==================== Meilisearch Configuration ====================
# Meilisearch full-text search service

MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=WILL_BE_GENERATED_ON_SETUP
MEILISEARCH_DOCUMENT_INDEX=asset-documents
MEILISEARCH_ASSET_INDEX=metadata-assets

# ==================== Service Ports ====================

GATEWAY_PORT=8000
SYSTEM_BACKEND_PORT=8080
SYSTEM_FRONTEND_PORT=8090
MANAGER_BACKEND_PORT=8081
MANAGER_FRONTEND_PORT=8091
META_BACKEND_PORT=8082
META_FRONTEND_PORT=8092
TRANSFER_BACKEND_PORT=8083
TRANSFER_FRONTEND_PORT=8093

# ==================== Service Integration ====================

ENABLE_SERVICE_INTEGRATION=true
SERVICE_CALL_TIMEOUT=30s

# ==================== Docker Registry ====================
# Will be set by deployment scripts

REGISTRY=localhost:5001

# ==================== Module-Specific Configuration ====================

# Manager Module
STORAGE_TYPE=minio
PREVIEW_MAX_ROWS=1000
PREVIEW_MAX_SIZE_MB=100

# Meta Module
PARSER_SAMPLE_SIZE=10000
PARSER_TIMEOUT=300s

# Transfer Module
WORKER_COUNT=5
CONCURRENT_TASKS=10
TASK_QUEUE_NAME=transfer:tasks
MAX_RETRIES=3
RETRY_DELAY=30s
DEFAULT_BATCH_SIZE=1000
TASK_TIMEOUT=3600s

# ==================== Logging ====================

LOG_LEVEL=info
LOG_FORMAT=json

# ==================== Environment ====================

ENV=production
