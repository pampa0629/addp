# =============================================================================
# Code Generator Selection (选择代码生成器)
# =============================================================================
# Options: codex_cli (推荐) | codex | claude
CODE_GENERATOR=codex_cli

# =============================================================================
# Codex CLI Configuration (推荐使用此模式)
# =============================================================================
# Codex API Key 存放位置：~/.codex/.apikey
# 请确保该文件存在并包含有效的 API Key
CODEX_CLI_PATH=codex
CODEX_CLI_ARGS="--skip-git-repo-check --full-auto"
CODEX_CLI_TIMEOUT=300s

# =============================================================================
# Codex API Configuration (备用：直接调用 Codex API)
# =============================================================================
# CODEX_API_KEY=your-codex-api-key-here
# CODEX_BASE_URL=https://api.aicodemirror.com/api/codex/backend-api/codex
# CODEX_MODEL=gpt-5

# =============================================================================
# Claude Configuration (暂停使用，代码保留)
# =============================================================================
# Option 1: Direct Anthropic API
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Option 2: Claude Code Proxy
# ANTHROPIC_BASE_URL=https://api.aicodemirror.com/api/claudecode
# ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_AUTH_TOKEN=your-auth-token-here

# Model Configuration
# CLAUDE_MODEL=claude-sonnet-4-5-20250929

# =============================================================================
# Server Configuration
# =============================================================================
PORT=8090
FRONTEND_URL=http://localhost:5180

# =============================================================================
# Code Execution
# =============================================================================
WORKSPACE_DIR=./workspace
AUTO_RELOAD=true
APPS_DATA_FILE=./workspace/apps.json
