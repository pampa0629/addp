# Python Workflow Engine - Prebuilt from local venv
# This Dockerfile creates an image using locally installed dependencies
FROM python:3.11-slim

# Install only runtime dependencies (no build tools)
RUN apt-get update && apt-get install -y \
    build-essential \
    g++ \
    gcc \
    libgeos-c1t64 \
    libproj25 \
    gdal-bin \
    libgdal-dev \
    libgdal36 \
    && rm -rf /var/lib/apt/lists/*

RUN GDAL_VERSION="$(gdal-config --version)" \
    && pip install --no-cache-dir "GDAL==${GDAL_VERSION}"

# Set working directory
WORKDIR /app

# Copy locally installed packages from venv
# Usage: Before building, ensure venv exists with all dependencies
COPY engines/python-workflow/venv/lib/python3.11/site-packages/ /usr/local/lib/python3.11/site-packages/
COPY common-python/ /tmp/common-python/
RUN pip install --no-cache-dir /tmp/common-python

# Copy application code
COPY engines/python-workflow/operators/ ./operators/
COPY engines/python-workflow/workflow_engine.py .
COPY engines/python-workflow/api_server.py .

# Expose Flask port
EXPOSE 8099

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PORT=8099
ENV PYTHONPATH=/usr/local/lib/python3.11/site-packages
ENV PYTHON_WORKFLOW_GUNICORN_TIMEOUT=7200

# Run with Gunicorn for production
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:8099 --workers 4 --timeout ${PYTHON_WORKFLOW_GUNICORN_TIMEOUT:-7200} api_server:app"]
