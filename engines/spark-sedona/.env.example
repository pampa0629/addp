# Spark Sedona Engine 环境配置

# System Backend URL (用于获取资源配置和注册引擎)
SYSTEM_SERVICE_URL=http://localhost:8080

# Develop Backend URL (用于任务API配置)
DEVELOP_SERVICE_URL=http://localhost:8085

# Internal API Key (用于注册到System)
INTERNAL_API_KEY=internal-api-key-change-in-production

# Flask API Server 端口
PORT=8098

# Spark 模式 (local 或 remote)
# local: 本地Spark模式 (用于开发测试)
# remote: 连接到用户注册的Spark集群
SPARK_MODE=local

# 日志级别
LOG_LEVEL=INFO
