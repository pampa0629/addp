  {
    "id": "st_buffer",
    "name": "st_buffer",
    "display_name": "缓冲区分析",
    "module": "spark",
    "category": "空间分析",
    "description": "创建几何对象的缓冲区",
    "brief_description": "在几何对象周围创建指定距离的缓冲区,常用于影响范围分析和空间查询",
    "detailed_description": {
      "overview": "缓冲区算子使用Apache Sedona的ST_Buffer函数在输入几何对象周围创建指定距离的区域。支持点、线、面三种几何类型,常用于影响范围分析、服务区计算等场景。缓冲距离单位与坐标系一致,地理坐标系需先转换为投影坐标系。",
      "parameters": [
        {
          "name": "input_df",
          "type": "dataframe",
          "required": true,
          "description": "输入DataFrame,必须包含有效的几何列",
          "notes": "几何列必须是Sedona Geometry类型,从PostgreSQL加载时使用ST_GeomFromWKB自动转换"
        },
        {
          "name": "geom_column",
          "type": "string",
          "required": false,
          "description": "几何列名,默认为'geom'",
          "notes": "如果数据来自多表连接,需要显式指定列名避免歧义"
        },
        {
          "name": "distance",
          "type": "float",
          "required": true,
          "description": "缓冲距离,单位与坐标系一致",
          "notes": "投影坐标系(如EPSG:32650)单位为米;地理坐标系(EPSG:4326)单位为度,1度≈111公里,建议先用st_transform转投影坐标系"
        },
        {
          "name": "output_column",
          "type": "string",
          "required": false,
          "description": "输出几何列名,默认为'buffer_geom'",
          "notes": "建议使用有意义的列名,如'buffer_500m'表示500米缓冲区"
        }
      ],
      "use_cases": [
        "河流污染影响范围分析: 河流中心线缓冲500米,统计影响范围内的建筑物数量和人口",
        "学校服务范围计算: 学校点位缓冲1000米,分析覆盖的居民区和适龄儿童分布",
        "道路噪音影响评估: 高速公路线缓冲200米,评估噪音影响区域面积和受影响居民数量",
        "自然保护区核心区划定: 保护区边界内缩100米(负距离),划定严格保护的核心区范围",
        "通信基站覆盖分析: 基站点位缓冲2000米,计算信号覆盖范围和重叠区域"
      ],
      "notes": [
        "地理坐标系(EPSG:4326)单位为度,缓冲1度≈111公里,必须先用st_transform转投影坐标系",
