          "type": "string",
          "required": true,
          "description": "表名",
          "notes": "参考参数定义中的说明"
        },
        {
          "name": "geom_column",
          "type": "string",
          "required": false,
          "description": "几何列名 (Sedona空间列)",
          "notes": "参考参数定义中的说明"
        },
        {
          "name": "path",
          "type": "string",
          "required": true,
          "description": "文件路径 (s3://bucket/file 或 hdfs://...)",
          "notes": "参考参数定义中的说明"
        },
        {
          "name": "format",
          "type": "enum",
