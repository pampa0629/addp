ARG BASE_IMAGE=192.168.106.71/datacenter/runtime-notebook-python:v3.0.0-aarch64
FROM ${BASE_IMAGE}

LABEL addp.service="supermap-workflow-engine"
LABEL addp.supermap.bundled="true"

ENV PORT=8103
ENV APP_ROOT=/app
ENV SUPERMAP_OBJECTSJAVA_BIN=/opt/supermap/objectsjava/bin_linux_arm64
ENV SUPERMAP_GPA_LIB_DIR=/opt/supermap/gpa/libs

USER root
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends libminizip1 libblosc1 nfs-common netbase \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/supermap/objectsjava/bin_linux_arm64 /opt/supermap/gpa/libs /app/license

COPY --from=objectsjava . /opt/supermap/objectsjava/bin_linux_arm64/
COPY --from=gpa_libs . /opt/supermap/gpa/libs/
COPY --from=license . /app/license/

COPY src /app/src
COPY run.sh /app/run.sh
RUN chmod +x /app/run.sh

EXPOSE 8103
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 CMD curl -fsS "http://localhost:${PORT:-8103}/health" | grep -q '"status":"healthy"' || exit 1
CMD ["/app/run.sh"]
