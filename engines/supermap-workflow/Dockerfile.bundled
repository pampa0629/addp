ARG BUILD_IMAGE=192.168.106.71/datacenter/runtime-notebook-python:v3.0.0-aarch64
ARG RUNTIME_IMAGE=192.168.106.71/public/iobjectjava:12.0.0-kylin-aarch64

FROM ${BUILD_IMAGE} AS builder

WORKDIR /build

COPY --from=objectsjava . /opt/supermap/objectsjava/bin_linux_arm64/
COPY --from=gpa_libs . /opt/supermap/gpa/libs/
COPY src /build/src

RUN mkdir -p /build/classes \
  && javac \
    -encoding UTF-8 \
    -cp "/opt/supermap/gpa/libs/*:/opt/supermap/objectsjava/bin_linux_arm64/*" \
    -d /build/classes \
    /build/src/main/java/com/addp/supermap/workflow/SuperMapWorkflowRuntime.java

FROM ${RUNTIME_IMAGE} AS runtime-root

USER root

RUN dnf install -y nfs-utils sqlite \
  && dnf clean all \
  && rm -rf \
    /opt/sup_iobjectsjava \
    /opt/SuperMap/License \
    /var/cache/dnf \
  && mkdir -p /opt/SuperMap/License

FROM scratch

LABEL addp.service="supermap-workflow-engine"
LABEL addp.supermap.bundled="true"

ENV PORT=8103
ENV APP_ROOT=/app
ENV JAVA_HOME=/opt/java
ENV PATH=/opt/java/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV SUPERMAP_OBJECTSJAVA_BIN=/opt/supermap/objectsjava/bin_linux_arm64
ENV SUPERMAP_GPA_LIB_DIR=/opt/supermap/gpa/libs

COPY --from=runtime-root / /

RUN mkdir -p /opt/supermap/objectsjava/bin_linux_arm64 /opt/supermap/gpa/libs /app/license

COPY --from=objectsjava . /opt/supermap/objectsjava/bin_linux_arm64/
COPY --from=gpa_libs . /opt/supermap/gpa/libs/
COPY --from=license . /app/license/

COPY --from=builder /build/classes /app/target/classes
COPY run.sh /app/run.sh
RUN chmod +x /app/run.sh

WORKDIR /app

EXPOSE 8103
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 CMD curl -fsS "http://localhost:${PORT:-8103}/health" | grep -q '"status":"healthy"' || exit 1
CMD ["/app/run.sh"]
