          "param_type": "input",
          "required": true,
          "description": "源 DatasetVector。"
        },
        {
          "name": "overlay_dataset",
          "type": "supermap.dataset",
          "param_type": "input",
          "required": true,
          "description": "叠加 DatasetVector。"
