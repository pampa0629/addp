# GeoPandas Engine - Prebuilt from local venv
# This Dockerfile creates an image using locally installed dependencies
FROM python:3.11-slim

# Install only runtime dependencies (no build tools)
RUN apt-get update && apt-get install -y \
    libgeos-c1t64 \
    libproj25 \
    gdal-bin \
    libgdal36 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy locally installed packages from venv
# Usage: Before building, ensure venv exists with all dependencies
COPY venv/lib/python3.11/site-packages/ /usr/local/lib/python3.11/site-packages/

# Copy application code
COPY operators.py .
COPY workflow_engine.py .
COPY api_server.py .

# Expose Flask port
EXPOSE 8099

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PORT=8099
ENV PYTHONPATH=/usr/local/lib/python3.11/site-packages

# Run with Gunicorn for production
CMD ["gunicorn", "--bind", "0.0.0.0:8099", "--workers", "4", "--timeout", "600", "api_server:app"]
