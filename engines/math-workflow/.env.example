# Math Workflow Engine 环境变量配置

# System Backend 服务地址
SYSTEM_SERVICE_URL=http://system-backend:8080

# 内部 API 密钥（用于自动注册）
INTERNAL_API_KEY=your_internal_api_key_here

# 引擎自身的 URL（用于注册到 System）
ENGINE_URL=http://math-workflow-engine:8097

# 服务端口
PORT=8097

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
