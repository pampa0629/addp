{
  "module": "math-workflow",
  "title": "Math Workflow 计算引擎",
  "version": "1.0.0",
  "lastUpdate": "2026-01-09",
  "categories": [
    {
      "name": "健康检查",
      "description": "引擎健康状态和依赖信息",
      "apis": [
        {
          "name": "健康检查",
          "method": "GET",
          "path": "/health",
          "description": "检查 Math Workflow 引擎的健康状态、版本信息和算子数量",
          "auth": false,
          "response": "{\n  \"status\": \"healthy\",\n  \"service\": \"math-workflow-engine\",\n  \"version\": \"1.0.0\",\n  \"uptime\": 3600,\n  \"operators_count\": 5\n}"
        }
      ]
    },
    {
      "name": "算子管理",
      "description": "算子列表查询和元数据获取",
      "apis": [
        {
          "name": "获取算子列表",
          "method": "GET",
          "path": "/api/operators",
          "description": "获取所有可用的数学运算算子列表（5个算子：add、subtract、multiply、divide、power）",
          "auth": false,
          "query": "category: 按分类过滤（可选）",
          "response": "{\n  \"status\": \"success\",\n  \"operators\": [\n    {\n      \"name\": \"add\",\n      \"display_name\": \"加法\",\n      \"category\": \"math\",\n      \"description\": \"两数相加\",\n      \"inputs\": [...],\n      \"outputs\": [...],\n      \"params\": [...]\n    }\n  ],\n  \"count\": 5\n}"
        }
      ]
    },
    {
      "name": "工作流执行",
      "description": "工作流即时执行和单算子执行",
      "apis": [
        {
          "name": "执行工作流",
          "method": "POST",
          "path": "/api/spatial/workflow",
          "description": "即时执行完整的工作流（支持 DAG 依赖关系）",
          "auth": false,
          "request": "{\n  \"workflow_def\": {\n    \"tasks\": [\n      {\"id\": \"task1\", \"operator\": \"add\", \"params\": {\"a\": 10, \"b\": 20}},\n      {\"id\": \"task2\", \"operator\": \"multiply\", \"params\": {\"a\": {\"$ref\": \"task1\"}, \"b\": 2}}\n    ]\n  }\n}",
          "response": "{\n  \"status\": \"success\",\n  \"execution_id\": \"uuid-...\",\n  \"final_result\": 60,\n  \"all_results\": {\"task1\": 30, \"task2\": 60},\n  \"execution_time_ms\": 12.34\n}"
        },
        {
          "name": "执行单个算子",
          "method": "POST",
          "path": "/api/spatial/operators/:name/execute",
          "description": "执行单个数学运算算子",
          "auth": false,
          "params": ":name - 算子名称（add、subtract、multiply、divide、power）",
          "request": "{\n  \"params\": {\n    \"a\": 10,\n    \"b\": 20\n  }\n}",
          "response": "{\n  \"status\": \"success\",\n  \"execution_id\": \"uuid-...\",\n  \"result\": 30,\n  \"execution_time_ms\": 1.23\n}"
        }
      ]
    },
    {
      "name": "执行状态查询",
      "description": "查询工作流执行状态和结果",
      "apis": [
        {
          "name": "查询执行状态",
          "method": "GET",
          "path": "/api/spatial/executions/:execution_id",
          "description": "查询工作流执行的状态和结果",
          "auth": false,
          "params": ":execution_id - 执行ID",
          "response": "{\n  \"status\": \"success\",\n  \"execution\": {\n    \"id\": \"uuid-...\",\n    \"status\": \"completed\",\n    \"result\": 60,\n    \"execution_time_ms\": 12.34\n  }\n}"
        }
      ]
    }
  ]
}
