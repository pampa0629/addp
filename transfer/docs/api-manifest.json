{
  "module": "transfer",
  "title": "数据传输模块",
  "version": "0.0.20",
  "categories": [
    {
      "name": "任务管理",
      "description": "数据传输任务的创建、启动、停止、查询等管理功能",
      "apis": [
        {
          "name": "创建传输任务",
          "method": "POST",
          "path": "/api/transfer/tasks",
          "description": "创建数据传输任务（支持批量传输和流式传输）",
          "auth": true,
          "request": "{\n  \"name\": \"任务名称\",\n  \"type\": \"sync\",\n  \"engine_id\": 1,\n  \"source_type\": \"postgres\",\n  \"source_config\": {\n    \"table\": \"users\"\n  },\n  \"target_type\": \"postgres\",\n  \"target_config\": {\n    \"table\": \"users_backup\"\n  },\n  \"schedule\": null,\n  \"enabled\": true\n}",
          "response": "{\n  \"id\": 123,\n  \"name\": \"任务名称\",\n  \"type\": \"sync\",\n  \"status\": \"pending\",\n  \"created_at\": \"2025-01-09T10:00:00Z\"\n}"
        },
        {
          "name": "获取任务列表",
          "method": "GET",
          "path": "/api/transfer/tasks",
          "description": "分页获取任务列表，支持按类型、状态过滤",
          "auth": true,
          "query": "page: 页码，默认 1\npage_size: 每页数量，默认 20\ntype: 任务类型（可选：import、export、sync）\nstatus: 任务状态（可选：pending、running、completed、failed）",
          "response": "{\n  \"data\": [\n    {\n      \"id\": 123,\n      \"name\": \"任务名称\",\n      \"type\": \"sync\",\n      \"status\": \"running\",\n      \"created_at\": \"2025-01-09T10:00:00Z\"\n    }\n  ],\n  \"total\": 50,\n  \"page\": 1,\n  \"page_size\": 20,\n  \"total_pages\": 3\n}"
        },
        {
          "name": "获取任务详情",
          "method": "GET",
          "path": "/api/transfer/tasks/:id",
          "description": "获取指定任务的详细信息",
          "auth": true,
          "params": ":id - 任务ID",
          "response": "{\n  \"id\": 123,\n  \"name\": \"任务名称\",\n  \"type\": \"sync\",\n  \"status\": \"running\",\n  \"engine_id\": 1,\n  \"source_type\": \"postgres\",\n  \"source_config\": {...},\n  \"target_type\": \"postgres\",\n  \"target_config\": {...},\n  \"created_at\": \"2025-01-09T10:00:00Z\",\n  \"updated_at\": \"2025-01-09T10:05:00Z\"\n}"
        },
        {
          "name": "更新任务",
          "method": "PUT",
          "path": "/api/transfer/tasks/:id",
          "description": "更新任务配置",
          "auth": true,
          "params": ":id - 任务ID",
          "request": "{\n  \"name\": \"任务名称-更新\",\n  \"enabled\": false\n}",
          "response": "{\n  \"id\": 123,\n  \"name\": \"任务名称-更新\",\n  \"enabled\": false,\n  \"updated_at\": \"2025-01-09T10:10:00Z\"\n}"
        },
        {
          "name": "删除任务",
          "method": "DELETE",
          "path": "/api/transfer/tasks/:id",
          "description": "删除指定任务",
          "auth": true,
          "params": ":id - 任务ID",
          "response": "{\n  \"message\": \"删除成功\"\n}"
        },
        {
          "name": "启动任务",
          "method": "POST",
          "path": "/api/transfer/tasks/:id/start",
          "description": "手动启动任务执行",
          "auth": true,
          "params": ":id - 任务ID",
          "response": "{\n  \"execution_id\": 456,\n  \"status\": \"running\",\n  \"message\": \"任务已启动\"\n}"
        },
        {
          "name": "停止任务",
          "method": "POST",
          "path": "/api/transfer/tasks/:id/stop",
          "description": "停止正在运行的任务",
          "auth": true,
          "params": ":id - 任务ID",
          "response": "{\n  \"message\": \"任务已停止\"\n}"
        },
        {
          "name": "暂停任务",
          "method": "POST",
          "path": "/api/transfer/tasks/:id/pause",
          "description": "暂停正在运行的任务",
          "auth": true,
          "params": ":id - 任务ID",
          "response": "{\n  \"message\": \"任务已暂停\"\n}"
        },
        {
          "name": "恢复任务",
          "method": "POST",
          "path": "/api/transfer/tasks/:id/resume",
          "description": "恢复已暂停的任务",
          "auth": true,
          "params": ":id - 任务ID",
          "response": "{\n  \"message\": \"任务已恢复\"\n}"
        },
        {
          "name": "获取任务统计",
          "method": "GET",
          "path": "/api/transfer/tasks/statistics",
          "description": "获取任务总数、成功数、失败数等统计信息",
          "auth": true,
          "response": "{\n  \"total\": 100,\n  \"pending\": 10,\n  \"running\": 5,\n  \"completed\": 80,\n  \"failed\": 5\n}"
        },
        {
          "name": "获取任务执行记录",
          "method": "GET",
          "path": "/api/transfer/tasks/:id/executions",
          "description": "获取指定任务的历史执行记录",
          "auth": true,
          "params": ":id - 任务ID",
          "query": "page: 页码，默认 1\npage_size: 每页数量，默认 20",
          "response": "{\n  \"data\": [\n    {\n      \"id\": 456,\n      \"task_id\": 123,\n      \"status\": \"completed\",\n      \"started_at\": \"2025-01-09T10:00:00Z\",\n      \"finished_at\": \"2025-01-09T10:05:00Z\"\n    }\n  ],\n  \"total\": 10,\n  \"page\": 1,\n  \"page_size\": 20\n}"
        }
      ]
    },
    {
      "name": "字段映射管理",
      "description": "数据字段映射配置",
      "apis": [
        {
          "name": "创建字段映射",
          "method": "POST",
          "path": "/api/transfer/tasks/:id/mappings",
          "description": "为任务创建源字段到目标字段的映射关系",
          "auth": true,
          "params": ":id - 任务ID",
          "request": "{\n  \"source_field\": \"user_name\",\n  \"target_field\": \"username\",\n  \"transform_rule\": null\n}",
          "response": "{\n  \"id\": 1,\n  \"task_id\": 123,\n  \"source_field\": \"user_name\",\n  \"target_field\": \"username\",\n  \"created_at\": \"2025-01-09T10:00:00Z\"\n}"
        },
        {
          "name": "获取任务字段映射",
          "method": "GET",
          "path": "/api/transfer/tasks/:id/mappings",
          "description": "获取指定任务的所有字段映射",
          "auth": true,
          "params": ":id - 任务ID",
          "response": "[\n  {\n    \"id\": 1,\n    \"task_id\": 123,\n    \"source_field\": \"user_name\",\n    \"target_field\": \"username\"\n  }\n]"
        },
        {
          "name": "删除字段映射",
          "method": "DELETE",
          "path": "/api/transfer/mappings/:id",
          "description": "删除指定的字段映射",
          "auth": true,
          "params": ":id - 映射ID",
          "response": "{\n  \"message\": \"删除成功\"\n}"
        }
      ]
    },
    {
      "name": "执行记录管理",
      "description": "任务执行记录的查询和控制",
      "apis": [
        {
          "name": "获取执行记录列表",
          "method": "GET",
          "path": "/api/transfer/executions",
          "description": "分页获取执行记录列表，支持按任务、状态过滤",
          "auth": true,
          "query": "page: 页码，默认 1\npage_size: 每页数量，默认 20\ntask_id: 任务ID（可选）\nstatus: 执行状态（可选：pending、running、completed、failed）",
          "response": "{\n  \"data\": [\n    {\n      \"id\": 456,\n      \"task_id\": 123,\n      \"task_name\": \"导入测试数据\",\n      \"status\": \"completed\",\n      \"started_at\": \"2025-01-09T10:00:00Z\",\n      \"finished_at\": \"2025-01-09T10:05:00Z\"\n    }\n  ],\n  \"total\": 100,\n  \"page\": 1,\n  \"page_size\": 20\n}"
        },
        {
          "name": "获取执行记录详情",
          "method": "GET",
          "path": "/api/transfer/executions/:id",
          "description": "获取执行记录的详细信息",
          "auth": true,
          "params": ":id - 执行记录ID",
          "response": "{\n  \"id\": 456,\n  \"task_id\": 123,\n  \"status\": \"completed\",\n  \"started_at\": \"2025-01-09T10:00:00Z\",\n  \"finished_at\": \"2025-01-09T10:05:00Z\",\n  \"processed_rows\": 1000,\n  \"error_message\": null\n}"
        },
        {
          "name": "获取执行统计",
          "method": "GET",
          "path": "/api/transfer/executions/statistics",
          "description": "获取执行记录的统计信息",
          "auth": true,
          "response": "{\n  \"total\": 500,\n  \"pending\": 10,\n  \"running\": 5,\n  \"completed\": 450,\n  \"failed\": 35\n}"
        },
        {
          "name": "取消执行",
          "method": "POST",
          "path": "/api/transfer/executions/:id/cancel",
          "description": "取消正在运行的执行",
          "auth": true,
          "params": ":id - 执行记录ID",
          "response": "{\n  \"message\": \"执行已取消\"\n}"
        },
        {
          "name": "重试执行",
          "method": "POST",
          "path": "/api/transfer/executions/:id/retry",
          "description": "重新执行失败的任务",
          "auth": true,
          "params": ":id - 执行记录ID",
          "response": "{\n  \"execution_id\": 457,\n  \"message\": \"任务已重新启动\"\n}"
        },
        {
          "name": "获取执行进度",
          "method": "GET",
          "path": "/api/transfer/executions/:id/progress",
          "description": "获取正在运行的执行的实时进度",
          "auth": true,
          "params": ":id - 执行记录ID",
          "response": "{\n  \"execution_id\": 456,\n  \"status\": \"running\",\n  \"progress_percentage\": 45,\n  \"processed_rows\": 450,\n  \"total_rows\": 1000,\n  \"current_step\": \"数据导入中\"\n}"
        },
        {
          "name": "获取执行日志",
          "method": "GET",
          "path": "/api/transfer/executions/:id/logs",
          "description": "获取执行的详细日志",
          "auth": true,
          "params": ":id - 执行记录ID",
          "query": "page: 页码，默认 1\npage_size: 每页数量，默认 100",
          "response": "{\n  \"data\": [\n    {\n      \"timestamp\": \"2025-01-09T10:00:01Z\",\n      \"level\": \"info\",\n      \"message\": \"开始导入数据\"\n    }\n  ],\n  \"total\": 50,\n  \"page\": 1,\n  \"page_size\": 100\n}"
        }
      ]
    },
    {
      "name": "本地引擎管理",
      "description": "Transfer 模块内部引擎配置管理",
      "apis": [
        {
          "name": "获取系统引擎列表",
          "method": "GET",
          "path": "/api/transfer/system-engines",
          "description": "从 System 模块获取所有可用的引擎列表",
          "auth": true,
          "response": "[\n  {\n    \"id\": 1,\n    \"name\": \"主数据库\",\n    \"engine_type\": \"postgres\",\n    \"description\": \"PostgreSQL 主数据库\"\n  }\n]"
        },
        {
          "name": "获取本地引擎列表",
          "method": "GET",
          "path": "/api/transfer/local-engines",
          "description": "获取 Transfer 模块本地缓存的引擎配置",
          "auth": true,
          "response": "[\n  {\n    \"id\": 1,\n    \"system_engine_id\": 1,\n    \"name\": \"主数据库\",\n    \"engine_type\": \"postgres\",\n    \"is_active\": true\n  }\n]"
        },
        {
          "name": "创建本地引擎",
          "method": "POST",
          "path": "/api/transfer/local-engines",
          "description": "创建新的本地引擎配置",
          "auth": true,
          "request": "{\n  \"system_engine_id\": 1,\n  \"name\": \"主数据库\",\n  \"engine_type\": \"postgres\",\n  \"connection_info\": {...}\n}",
          "response": "{\n  \"id\": 1,\n  \"system_engine_id\": 1,\n  \"name\": \"主数据库\",\n  \"is_active\": true,\n  \"created_at\": \"2025-01-09T10:00:00Z\"\n}"
        },
        {
          "name": "更新本地引擎",
          "method": "PUT",
          "path": "/api/transfer/local-engines/:id",
          "description": "更新本地引擎配置",
          "auth": true,
          "params": ":id - 本地引擎ID",
          "request": "{\n  \"name\": \"主数据库-更新\",\n  \"is_active\": false\n}",
          "response": "{\n  \"id\": 1,\n  \"name\": \"主数据库-更新\",\n  \"is_active\": false,\n  \"updated_at\": \"2025-01-09T10:05:00Z\"\n}"
        },
        {
          "name": "删除本地引擎",
          "method": "DELETE",
          "path": "/api/transfer/local-engines/:id",
          "description": "删除本地引擎配置",
          "auth": true,
          "params": ":id - 本地引擎ID",
          "response": "{\n  \"message\": \"删除成功\"\n}"
        },
        {
          "name": "创建前测试连接",
          "method": "POST",
          "path": "/api/transfer/local-engines/test-connection",
          "description": "创建引擎前测试连接配置是否有效",
          "auth": true,
          "request": "{\n  \"engine_type\": \"postgres\",\n  \"connection_info\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"testdb\",\n    \"username\": \"user\",\n    \"password\": \"pass\"\n  }\n}",
          "response": "{\n  \"success\": true,\n  \"message\": \"连接测试成功\"\n}"
        },
        {
          "name": "测试已有引擎连接",
          "method": "POST",
          "path": "/api/transfer/local-engines/:id/test",
          "description": "测试已有引擎的连接状态",
          "auth": true,
          "params": ":id - 本地引擎ID",
          "response": "{\n  \"success\": true,\n  \"message\": \"连接测试成功\"\n}"
        },
        {
          "name": "同步引擎配置",
          "method": "POST",
          "path": "/api/transfer/local-engines/:id/sync",
          "description": "从 System 模块同步引擎配置更新",
          "auth": true,
          "params": ":id - 本地引擎ID",
          "response": "{\n  \"message\": \"同步成功\",\n  \"updated_at\": \"2025-01-09T10:05:00Z\"\n}"
        },
        {
          "name": "列出引擎的表",
          "method": "GET",
          "path": "/api/transfer/local-engines/:id/tables",
          "description": "列出指定引擎下的所有表",
          "auth": true,
          "params": ":id - 本地引擎ID",
          "query": "schema: 数据库schema（可选）",
          "response": "[\n  {\"table_name\": \"users\", \"schema\": \"public\"},\n  {\"table_name\": \"orders\", \"schema\": \"public\"}\n]"
        },
        {
          "name": "列出表的字段",
          "method": "GET",
          "path": "/api/transfer/local-engines/:id/fields",
          "description": "列出指定表的所有字段",
          "auth": true,
          "params": ":id - 本地引擎ID",
          "query": "schema: 数据库schema\ntable: 表名",
          "response": "[\n  {\n    \"field_name\": \"id\",\n    \"data_type\": \"integer\",\n    \"is_nullable\": false\n  },\n  {\n    \"field_name\": \"username\",\n    \"data_type\": \"varchar\",\n    \"is_nullable\": false\n  }\n]"
        }
      ]
    },
    {
      "name": "对象存储辅助",
      "description": "对象存储浏览和操作",
      "apis": [
        {
          "name": "浏览对象存储目录",
          "method": "POST",
          "path": "/api/transfer/object-storage/browse",
          "description": "浏览 MinIO/S3 对象存储的目录结构",
          "auth": true,
          "request": "{\n  \"engine_id\": 2,\n  \"bucket\": \"data-bucket\",\n  \"prefix\": \"uploads/\"\n}",
          "response": "{\n  \"directories\": [\"uploads/2025/\", \"uploads/archive/\"],\n  \"files\": [\n    {\n      \"name\": \"data.csv\",\n      \"size\": 1024000,\n      \"last_modified\": \"2025-01-09T10:00:00Z\"\n    }\n  ]\n}"
        }
      ]
    },
    {
      "name": "数据转换器",
      "description": "数据转换插件管理",
      "apis": [
        {
          "name": "列出所有转换器",
          "method": "GET",
          "path": "/api/transfer/transforms",
          "description": "获取所有可用的数据转换器列表",
          "auth": true,
          "response": "[\n  {\n    \"name\": \"csv_to_json\",\n    \"description\": \"CSV 转 JSON\",\n    \"input_format\": \"csv\",\n    \"output_format\": \"json\"\n  }\n]"
        },
        {
          "name": "获取转换器统计",
          "method": "GET",
          "path": "/api/transfer/transforms/stats",
          "description": "获取转换器使用统计信息",
          "auth": true,
          "response": "{\n  \"total_transforms\": 5,\n  \"total_usage\": 1000,\n  \"most_used\": \"csv_to_json\"\n}"
        },
        {
          "name": "获取转换器能力",
          "method": "GET",
          "path": "/api/transfer/transforms/:name",
          "description": "获取指定转换器的能力描述和配置参数",
          "auth": true,
          "params": ":name - 转换器名称",
          "response": "{\n  \"name\": \"csv_to_json\",\n  \"description\": \"CSV 转 JSON\",\n  \"input_format\": \"csv\",\n  \"output_format\": \"json\",\n  \"parameters\": [\n    {\n      \"name\": \"delimiter\",\n      \"type\": \"string\",\n      \"default\": \",\",\n      \"description\": \"CSV 分隔符\"\n    }\n  ]\n}"
        },
        {
          "name": "验证转换器配置",
          "method": "POST",
          "path": "/api/transfer/transforms/:name/validate",
          "description": "验证转换器配置是否有效",
          "auth": true,
          "params": ":name - 转换器名称",
          "request": "{\n  \"config\": {\n    \"delimiter\": \",\",\n    \"encoding\": \"utf-8\"\n  }\n}",
          "response": "{\n  \"valid\": true,\n  \"message\": \"配置有效\"\n}"
        },
        {
          "name": "测试转换器",
          "method": "POST",
          "path": "/api/transfer/transforms/:name/test",
          "description": "使用示例数据测试转换器",
          "auth": true,
          "params": ":name - 转换器名称",
          "request": "{\n  \"config\": {...},\n  \"sample_data\": \"name,age\\nJohn,30\\nJane,25\"\n}",
          "response": "{\n  \"success\": true,\n  \"output\": \"[{\\\"name\\\":\\\"John\\\",\\\"age\\\":30},{\\\"name\\\":\\\"Jane\\\",\\\"age\\\":25}]\"\n}"
        }
      ]
    }
  ]
}
