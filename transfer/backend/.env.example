# Transfer 模块配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# ==================== 服务配置 ====================
# Transfer 服务端口
PORT=8083

# 数据库 Schema
DB_SCHEMA=transfer

# ==================== 服务间调用 ====================
# System 服务地址（用于获取共享配置和资源信息）
SYSTEM_SERVICE_URL=http://localhost:8080

# 是否启用服务集成（从 System 获取配置）
ENABLE_SERVICE_INTEGRATION=true

# 内部 API 密钥（必须与 System 模块保持一致）
# 生成方式: openssl rand -base64 32
INTERNAL_API_KEY=dev-internal-key

# ==================== 数据加密 ====================
# 加密密钥（32字节，Base64编码）
# 用于加密存储引擎的密码和密钥
# 生成方式:
#   1. 生成32字节随机密钥: openssl rand -base64 32
#   2. 复制输出的字符串到下面
#
# 重要：
#   - 必须与 System 模块使用相同的密钥（便于资源迁移）
#   - 生产环境必须设置此值
#   - 密钥丢失将导致已加密的密码无法解密
#   - 从根目录 .env 读取，所有模块共用
ENCRYPTION_KEY=

# ==================== 数据库配置（Fallback） ====================
# 当 ENABLE_SERVICE_INTEGRATION=false 或 System 服务不可用时使用
DB_HOST=localhost
DB_PORT=5432
DB_USER=addp
DB_PASSWORD=addp_password
DB_NAME=addp

# ==================== Redis 配置 ====================
# Redis 地址（用于任务队列）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=addp_redis

# ==================== 任务配置 ====================
# Worker 数量（并发执行任务的进程数）
WORKER_COUNT=5

# 并发任务数（每个 Worker 同时执行的任务数）
CONCURRENT_TASKS=10

# 任务队列名称
TASK_QUEUE_NAME=transfer:tasks

# 默认批大小（批量处理记录数）
DEFAULT_BATCH_SIZE=1000

# 任务超时时间（秒）
TASK_TIMEOUT=3600

# ==================== 重试配置 ====================
# 最大重试次数
MAX_RETRIES=3

# 重试延迟（支持格式: 30s, 5m, 1h）
RETRY_DELAY=30s

# ==================== 日志配置 ====================
# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 日志格式: json, text
LOG_FORMAT=json

# 是否添加源码位置
LOG_ADD_SOURCE=false

# 日志文件路径（为空则只输出到控制台）
LOG_FILE=

# ==================== 开发环境提示 ====================
# 本文件是配置模板，实际使用时：
# 1. 复制为 .env: cp .env.example .env
# 2. 修改配置值（特别是密钥和密码）
# 3. 确保 .env 文件不要提交到 Git（已在 .gitignore 中）
# 4. 生产环境必须设置 ENCRYPTION_KEY 和 INTERNAL_API_KEY
