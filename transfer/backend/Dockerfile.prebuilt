FROM localhost:5001/ubuntu24:latest

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates tzdata && rm -rf /var/lib/apt/lists/*

# Build arguments for precise binary selection
ARG BUILD_ARCH=amd64
ARG BUILD_TYPE=release
ARG GOOS=linux

WORKDIR /app

# 复制本地编译好的二进制文件（从扁平化 dist/ 目录）
# 路径: dist/{build}-{os}-{arch}/transfer
COPY dist/${BUILD_TYPE}-${GOOS}-${BUILD_ARCH}/transfer ./server
RUN chmod +x ./server

EXPOSE 8083

CMD ["./server"]
