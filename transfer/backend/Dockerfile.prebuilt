FROM localhost:5001/alpine:latest

# Automatic architecture detection
ARG TARGETARCH

WORKDIR /app

# 复制本地预编译的二进制（支持 server 或 server-<arch> 命名）
COPY transfer/backend/server* ./
RUN if [ -f server ]; then :; \
    elif [ -f server-amd64 ]; then mv server-amd64 server; \
    elif [ -f server-arm64 ]; then mv server-arm64 server; \
    else echo "server binary not found" && exit 1; fi

EXPOSE 8083

CMD ["./server"]
