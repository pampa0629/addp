FROM localhost:5001/alpine:latest

# Build arguments for precise binary selection
ARG BUILD_ARCH=amd64
ARG BUILD_TYPE=release
ARG GOOS=linux

WORKDIR /app

# 复制本地编译好的 worker 二进制文件（从扁平化 dist/ 目录）
# 路径: dist/{build}-{os}-{arch}/transfer-worker
COPY dist/${BUILD_TYPE}-${GOOS}-${BUILD_ARCH}/transfer-worker ./worker
RUN chmod +x ./worker

CMD ["./worker"]
