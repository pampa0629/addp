# Transfer Worker Dockerfile (prebuilt binary)

FROM alpine:latest

WORKDIR /app

# Install ca-certificates for HTTPS requests
RUN apk add --no-cache ca-certificates

# Copy precompiled binary produced by scripts/deploy/0-compile-binaries.sh
# or `make build-worker`, then move/copy to transfer/backend/worker
COPY transfer/backend/worker ./worker

CMD ["./worker"]
