package service

import (
	"fmt"

	commonClient "github.com/addp/common/client"
	"github.com/addp/transfer/internal/models"
	"github.com/addp/transfer/pkg/pipeline"
)

// TaskBuilder 执行任务构建器
// 职责：将Task、Execution、Mappings转换为ExecutionTask
type TaskBuilder struct {
	systemClient *commonClient.SystemClient
	task         *models.Task
	execution    *models.TaskExecution
	mappings     []models.DataMapping
}

// NewTaskBuilder 创建任务构建器
func NewTaskBuilder(systemClient *commonClient.SystemClient) *TaskBuilder {
	return &TaskBuilder{
		systemClient: systemClient,
	}
}

// WithTask 设置任务
func (b *TaskBuilder) WithTask(task *models.Task) *TaskBuilder {
	b.task = task
	return b
}

// WithExecution 设置执行记录
func (b *TaskBuilder) WithExecution(execution *models.TaskExecution) *TaskBuilder {
	b.execution = execution
	return b
}

// WithMappings 设置字段映射
func (b *TaskBuilder) WithMappings(mappings []models.DataMapping) *TaskBuilder {
	b.mappings = mappings
	return b
}

// Build 构建执行任务
func (b *TaskBuilder) Build() (*pipeline.ExecutionTask, error) {
	if b.task == nil {
		return nil, fmt.Errorf("task is required")
	}

	// 1. 解析source和target配置
	sourceConfig, err := b.resolveConfig("source", b.task.SourceID)
	if err != nil {
		return nil, fmt.Errorf("failed to resolve source config: %w", err)
	}

	targetConfig, err := b.resolveConfig("target", b.task.TargetID)
	if err != nil {
		return nil, fmt.Errorf("failed to resolve target config: %w", err)
	}

	// 2. 提取几何字段
	geometryFields := extractGeometryFields(targetConfig)
	if len(geometryFields) == 0 {
		geometryFields = extractGeometryFields(sourceConfig)
	}

	// 3. 构建转换器
	transforms, err := b.buildTransforms(geometryFields)
	if err != nil {
		return nil, fmt.Errorf("failed to build transforms: %w", err)
	}

	// 4. 创建Reader和Writer
	reader, err := b.createReader(sourceConfig)
	if err != nil {
		return nil, fmt.Errorf("failed to create reader: %w", err)
	}

	writer, err := b.createWriter(targetConfig)
	if err != nil {
		return nil, fmt.Errorf("failed to create writer: %w", err)
	}

	// 5. 构建ExecutionTask
	execTask := &pipeline.ExecutionTask{
		ID:         b.execution.ID,
		TaskID:     b.task.ID,
		Reader:     reader,
		Writer:     writer,
		Transforms: transforms,
	}

	return execTask, nil
}

// resolveConfig 解析连接器配置
func (b *TaskBuilder) resolveConfig(connectorType string, resourceID *uint) (map[string]interface{}, error) {
	config := b.task.Config

	// 从任务配置中获取
	connectorConfig, ok := config[connectorType].(map[string]interface{})
	if !ok {
		return nil, fmt.Errorf("%s config not found", connectorType)
	}

	// 如果配置了resource_id，从System获取资源配置
	if resourceID != nil && *resourceID > 0 {
		resource, err := b.systemClient.GetEngine(*resourceID)
		if err != nil {
			return nil, fmt.Errorf("failed to get resource %d: %w", *resourceID, err)
		}

		// 合并资源配置到连接器配置
		connectorConfig["engine_type"] = resource.EngineType
		connectorConfig["connection_info"] = resource.ConnectionInfo
	}

	return connectorConfig, nil
}

// buildTransforms 构建转换器列表
func (b *TaskBuilder) buildTransforms(geometryFields []string) ([]pipeline.Transform, error) {
	transforms := make([]pipeline.Transform, 0)

	// 1. 字段映射转换
	if len(b.mappings) > 0 {
		fieldMappings := make([]pipeline.FieldMapping, len(b.mappings))
		for i, m := range b.mappings {
			fieldMappings[i] = pipeline.FieldMapping{
				Source:       m.SourceField,
				Target:       m.TargetField,
				Type:         m.FieldType,
				Format:       m.Format,
				DefaultValue: m.DefaultValue,
			}
		}
		ensureGeometryMappings(&fieldMappings, geometryFields)
		transforms = append(transforms, pipeline.NewFieldMappingTransform(fieldMappings))
	}

	// 2. 其他转换（从配置中加载）
	if transformsConfig, ok := b.task.Config["transforms"].([]interface{}); ok {
		for _, tc := range transformsConfig {
			transformConfig, ok := tc.(map[string]interface{})
			if !ok {
				continue
			}

			transform, err := b.createTransformFromConfig(transformConfig)
			if err != nil {
				return nil, fmt.Errorf("failed to create transform: %w", err)
			}

			if transform != nil {
				transforms = append(transforms, transform)
			}
		}
	}

	return transforms, nil
}

// createReader 创建Reader
func (b *TaskBuilder) createReader(config map[string]interface{}) (pipeline.Reader, error) {
	// 委托给pipeline包的Reader工厂
	return pipeline.CreateReader(config)
}

// createWriter 创建Writer
func (b *TaskBuilder) createWriter(config map[string]interface{}) (pipeline.Writer, error) {
	// 委托给pipeline包的Writer工厂
	return pipeline.CreateWriter(config)
}

// createTransformFromConfig 从配置创建Transform
func (b *TaskBuilder) createTransformFromConfig(config map[string]interface{}) (pipeline.Transform, error) {
	// 委托给pipeline包的Transform工厂
	return pipeline.CreateTransform(config)
}

// 辅助函数（从原task_service.go提取）

func extractGeometryFields(config map[string]interface{}) []string {
	var geometryFields []string

	if fields, ok := config["geometry_fields"].([]interface{}); ok {
		for _, field := range fields {
			if fieldStr, ok := field.(string); ok {
				geometryFields = append(geometryFields, fieldStr)
			}
		}
	} else if field, ok := config["geometry_field"].(string); ok {
		geometryFields = append(geometryFields, field)
	}

	return geometryFields
}

func ensureGeometryMappings(fieldMappings *[]pipeline.FieldMapping, geometryFields []string) {
	if len(geometryFields) == 0 {
		return
	}

	// 确保几何字段在映射中
	for _, geoField := range geometryFields {
		found := false
		for _, mapping := range *fieldMappings {
			if mapping.Source == geoField || mapping.Target == geoField {
				found = true
				break
			}
		}

		if !found {
			*fieldMappings = append(*fieldMappings, pipeline.FieldMapping{
				Source: geoField,
				Target: geoField,
				Type:   "geometry",
			})
		}
	}
}
