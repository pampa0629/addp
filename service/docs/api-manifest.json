{
  "module": "service",
  "title": "数据服务模块",
  "version": "0.0.20",
  "categories": [
    {
      "name": "数据服务",
      "description": "外部服务注册、数据查询服务、OGC 标准支持",
      "apis": [
        {
          "name": "注册外部服务",
          "method": "POST",
          "path": "/api/service/external/register",
          "description": "注册外部数据服务（OGC WMS/WFS/WCS）",
          "auth": true,
          "request": "{\n  \"name\": \"天地图底图服务\",\n  \"type\": \"wms\",\n  \"url\": \"http://t0.tianditu.gov.cn/vec_w/wmts\",\n  \"capabilities\": {...}\n}",
          "response": "{\n  \"service_id\": 123,\n  \"status\": \"registered\",\n  \"message\": \"服务注册成功\"\n}"
        },
        {
          "name": "发布数据服务",
          "method": "POST",
          "path": "/api/service/publish",
          "description": "将数据表发布为 OGC 服务（WMS/WFS）",
          "auth": true,
          "request": "{\n  \"engine_id\": 1,\n  \"schema\": \"public\",\n  \"table\": \"cities\",\n  \"service_type\": \"wfs\",\n  \"name\": \"全国城市数据服务\"\n}",
          "response": "{\n  \"service_id\": 456,\n  \"service_url\": \"http://localhost:8000/api/service/ogc/wfs/456\",\n  \"capabilities_url\": \"http://localhost:8000/api/service/ogc/wfs/456?request=GetCapabilities\"\n}"
        },
        {
          "name": "数据查询",
          "method": "POST",
          "path": "/api/service/query",
          "description": "查询已发布的数据服务",
          "auth": true,
          "request": "{\n  \"service_id\": 456,\n  \"bbox\": [116.1, 39.7, 116.6, 40.2],\n  \"crs\": \"EPSG:4326\",\n  \"limit\": 100\n}",
          "response": "{\n  \"type\": \"FeatureCollection\",\n  \"features\": [...],\n  \"count\": 25\n}"
        }
      ]
    }
  ]
}
