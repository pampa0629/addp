      }
    },
    {
      "id": "policy_spec",
      "owner": "transfer",
      "kind": "normative",
      "path": "transfer/docs/transfer-任务语义与同步模式.md",
      "anchor": "## 三、当前支持矩阵",
      "commit": "e098da99a0cdb691b311962aaee6e006b2d0ce3a",
      "sha256": "3ef63fcc860d7a9f9e2fe1ea7bcc73d814b905139c304c7b3f5da5999717d214",
      "use": {
        "zh-cn": "正式支持矩阵区分快照 replace/append 与增量 upsert，不混用装载和写入方式",
        "en": "Formal matrix distinguishes snapshot replace/append from incremental upsert"
      }
    },
    {
      "id": "planner",
      "owner": "transfer",
      "kind": "implementation",
      "path": "transfer/backend/internal/planner/table_export.go",
