  "coverage": [
    {
      "id": "transfer.task.create",
      "state": "modeled",
      "summary": {
        "zh-cn": "只建未启动的 native table 有界快照任务，目标仅 replace/append；标准类型及配置校验不证明实际值可转换或执行成功，不是 Transfer 全功能声明",
        "en": "Create only a stopped native table bounded snapshot task with replace/append; standard type and configuration checks do not prove value conversion or execution success, nor full Transfer coverage"
      },
      "sources": [
        "manifest",
        "handler",
        "owner_test",
        "policy_spec",
        "planner"
      ]
    },
    {
      "id": "transfer.task.config.check",
      "state": "not_modeled",
      "summary": {
        "zh-cn": "正式只读配置预检 API、SDK 和 Tool 已存在；尚未装配进平台创建条件与 Agent 复核，当前配置复核不能称为预检通过",
        "en": "The formal read-only config check API, SDK and Tool exist; platform creation conditions and Agent review do not yet consume them, so current configuration review is not a passed precheck"
      },
      "sources": ["config", "manifest"]
    },
