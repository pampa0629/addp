# =============================================================================
# ADDP Production Environment
# =============================================================================

# Registry Configuration
REGISTRY=localhost:5001

# Security Keys (Auto-generated)
JWT_SECRET=JaIbjjBAjnoB5ottHp/rYJdix5tAda3rr9wgKPEg0s4=
ENCRYPTION_KEY=x/7t1SvL5IWivA88NyH/WUPHX1RtjHeBY4I+2Rhl/RU=
INTERNAL_API_KEY=tDkOIP6P+Io6cZ2WUBcgbxDkdPU95rTTCVgimW71pio=

# Super Admin
SUPER_ADMIN_USERNAME=SuperAdmin
SUPER_ADMIN_PASSWORD=20251001#SuperAdmin
SUPER_ADMIN_EMAIL=admin@addp.local

# Database
POSTGRES_USER=addp
POSTGRES_PASSWORD=addp_password
POSTGRES_DB=addp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=addp_redis

# Infra MinIO
# 基础设施级对象存储，用于系统文件、模块缓存、审计日志归档等。
# 不等于用户业务库对象存储；业务对象存储通过 System 引擎管理维护。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio-system:9000
MINIO_BUCKET=system

# MinIO Business
BUSINESS_MINIO_ENDPOINT=host.docker.internal:9002
BUSINESS_MINIO_ACCESS_KEY=minioadmin
BUSINESS_MINIO_SECRET_KEY=minioadmin

# Service Ports
GATEWAY_PORT=8000
SYSTEM_BACKEND_PORT=8180    # 避免与企业微信等应用的8080端口冲突
SERVER_ADDR=:8180            # System Backend 实际使用的环境变量
MANAGER_BACKEND_PORT=8081
META_BACKEND_PORT=8082

# Service Integration
ENABLE_SERVICE_INTEGRATION=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Audit log archive
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_LOG_ARCHIVE_ENABLED=false
AUDIT_LOG_ARCHIVE_CRON="0 2 * * *"

# Environment
ENV=production
