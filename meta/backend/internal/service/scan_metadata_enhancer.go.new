package service

import (
	"context"
	"fmt"
	"log/slog"
	"strings"
	"time"

	"github.com/addp/common/embedding"
	commonModels "github.com/addp/common/models"
	"github.com/addp/common/vectorstore"
	"github.com/addp/meta/internal/models"
	"github.com/addp/meta/plugins"
	"gorm.io/gorm"
)

// MetadataEnhancerService 元数据增强服务（简化版）
type MetadataEnhancerService struct {
	db                 *gorm.DB
	log                *slog.Logger
	vectorStore        *vectorstore.PgVectorStore
	multiModalEmbedder embedding.MultiModalEmbedder
	embeddingTimeout   time.Duration
	metaOps            *ScanServiceNew
}

// NewMetadataEnhancerService 创建元数据增强服务
func NewMetadataEnhancerService(
	db *gorm.DB,
	log *slog.Logger,
	vectorStore *vectorstore.PgVectorStore,
	embedder embedding.MultiModalEmbedder,
	timeout time.Duration,
	metaOps *ScanServiceNew,
) *MetadataEnhancerService {
	return &MetadataEnhancerService{
		db:                 db,
		log:                log,
		vectorStore:        vectorStore,
		multiModalEmbedder: embedder,
		embeddingTimeout:   timeout,
		metaOps:            metaOps,
	}
}

// PersistObjectMetasWithEnhancement 持久化对象元数据（占位实现）
// 注：具体实现委托给 ScanServiceNew.persistObjectMetas
func (s *MetadataEnhancerService) PersistObjectMetasWithEnhancement(
	resource *commonModels.Engine,
	tenantID, engineID uint,
	bucketNode *models.MetaNode,
	metas []plugins.ObjectMetadata,
	stats map[uint]*nodeAggregate,
	includeBucketAggregate bool,
	scanDepth string,
	scanPathPrefix string,
	scannedFingerprints map[string]bool,
) (int, error) {
	// 委托给主服务的persistObjectMetas方法
	return s.metaOps.persistObjectMetas(
		resource, tenantID, engineID,
		bucketNode, metas, stats,
		includeBucketAggregate,
		scanDepth, scanPathPrefix,
		scannedFingerprints,
	)
}

// buildDirectoryHierarchy 构建目录层级（辅助函数）
func (s *MetadataEnhancerService) buildDirectoryHierarchy(
	tenantID, engineID uint,
	bucketNode *models.MetaNode,
	objectPath string,
) (*models.MetaNode, error) {
	// 解析路径
	dirs := parseObjectPath(objectPath)
	if len(dirs) == 0 {
		return bucketNode, nil
	}

	// 逐级创建目录节点
	parentNode := bucketNode
	currentPath := bucketNode.Name

	for i := 0; i < len(dirs)-1; i++ {
		dirName := dirs[i]
		currentPath = currentPath + "/" + dirName

		dirNode, err := s.metaOps.upsertNode(
			tenantID, engineID,
			parentNode, "directory",
			dirName, currentPath, nil,
		)
		if err != nil {
			return nil, fmt.Errorf("创建目录节点失败: %w", err)
		}

		parentNode = dirNode
	}

	return parentNode, nil
}

// 辅助函数

func parseObjectPath(key string) []string {
	if key == "" {
		return nil
	}
	return strings.Split(key, "/")
}

func getObjectName(key string) string {
	parts := strings.Split(key, "/")
	if len(parts) == 0 {
		return key
	}
	return parts[len(parts)-1]
}
