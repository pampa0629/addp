FROM localhost:5001/alpine:latest

# Automatic architecture detection
ARG TARGETARCH

WORKDIR /app

# 复制本地预编译的二进制（支持 worker 或 worker-<arch> 命名）
COPY meta/backend/worker* ./
RUN if [ -f worker ]; then :; \
    elif [ -f worker-amd64 ]; then mv worker-amd64 worker; \
    elif [ -f worker-arm64 ]; then mv worker-arm64 worker; \
    else echo "worker binary not found" && exit 1; fi

CMD ["./worker"]
