# Meta Worker Dockerfile (prebuilt binary)

FROM alpine:latest

WORKDIR /app

# Install ca-certificates for HTTPS requests
RUN apk add --no-cache ca-certificates

# Copy precompiled binary produced by scripts/build/compile.sh
# or `make build-meta-worker`, then move/copy to meta/backend/worker
COPY meta/backend/worker ./worker

CMD ["./worker"]
