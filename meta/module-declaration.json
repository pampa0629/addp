{
  "module_name": "meta",
  "route_prefix": "/meta",
  "task_provider": {
    "display_name": "元数据管理",
    "description": "元数据扫描、索引、向量化任务",
    "task_list_endpoint": "/api/v1/meta/task-provider/tasks",
    "task_detail_endpoint": "/api/v1/meta/task-provider/tasks/{task_type}/{id}",
    "task_execute_endpoint": "/api/v1/meta/task-provider/tasks/{task_type}/{id}/execute",
    "task_status_endpoint": "/api/v1/meta/task-provider/executions/{execution_id}",
    "capabilities": {
      "schema_version": "task.capabilities/v2",
      "task_capabilities": [
        {
          "create_url": "/meta/scan",
          "definition_schema": {
            "type": "object"
          },
          "deprecated": false,
          "description": "执行 Meta ScanTask",
          "display_name": "元数据扫描",
          "edit_url": "/meta/scan?task_id=:id",
          "supports_cancel": false,
          "supports_inline_execution": false,
          "supports_schedule": true,
          "type": "scan"
        }
      ],
      "x_features": [
        "async",
        "cron",
        "spatial_facts",
        "vector_index"
      ],
      "x_supported_source_models": [
        "tabular_catalog",
        "branch_leaf_catalog",
        "object_catalog",
        "file_catalog"
      ]
    }
  }
}
