# 生产环境 docker-compose 配置
# 用于从私有 Registry 拉取镜像部署
#
# 使用方法:
#   1. 复制到服务器: scp docker-compose.prod.yml server:/opt/addp/
#   2. 配置 Registry: export REGISTRY=192.168.1.100:5000
#   3. 启动服务: docker-compose -f docker-compose.prod.yml --profile full up -d

services:
  # ==================== 基础设施服务 ====================

  postgres:
    image: postgres:15-alpine
    container_name: addp-postgres
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-addp}
      POSTGRES_USER: ${POSTGRES_USER:-addp}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-addp_password}
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./scripts/init-db.sql:/docker-entrypoint-initdb.d/init-db.sql
    ports:
      - "5432:5432"
    networks:
      - addp-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-addp}"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: addp-redis
    command: redis-server --requirepass ${REDIS_PASSWORD:-addp_redis}
    volumes:
      - redis_data:/data
    ports:
      - "6379:6379"
    networks:
      - addp-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "--raw", "incr", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  minio-system:
    image: minio/minio:latest
    container_name: addp-minio-system
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: ${MINIO_SYSTEM_ROOT_USER:-minioadmin}
      MINIO_ROOT_PASSWORD: ${MINIO_SYSTEM_ROOT_PASSWORD:-minioadmin}
    volumes:
      - minio_system_data:/data
    ports:
      - "9000:9000"
      - "9001:9001"
    networks:
      - addp-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 10s
      timeout: 5s
      retries: 5

  elasticsearch:
    image: docker.elastic.co/elasticsearch/elasticsearch:8.11.0
    container_name: addp-elasticsearch
    environment:
      - discovery.type=single-node
      - xpack.security.enabled=false
      - "ES_JAVA_OPTS=-Xms512m -Xmx512m"
    volumes:
      - elasticsearch_data:/usr/share/elasticsearch/data
    ports:
      - "9200:9200"
    networks:
      - addp-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:9200/_cluster/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5

  # ==================== System 模块 ====================

  system-backend:
    image: ${REGISTRY:-localhost:5000}/addp-system-backend:${IMAGE_TAG:-latest}
    container_name: addp-system-backend
    environment:
      - PORT=8080
      - JWT_SECRET=${JWT_SECRET}
      - DB_PATH=/app/data/addp.db
      - ENCRYPTION_KEY=${ENCRYPTION_KEY}
      - GIN_MODE=release
    volumes:
      - system_data:/app/data
    ports:
      - "8080:8080"
    networks:
      - addp-network
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 10s
      timeout: 5s
      retries: 5

  system-frontend:
    image: ${REGISTRY:-localhost:5000}/addp-system-frontend:${IMAGE_TAG:-latest}
    container_name: addp-system-frontend
    ports:
      - "8090:80"
    networks:
      - addp-network
    depends_on:
      - system-backend
    restart: unless-stopped

  # ==================== Manager 模块 ====================

  manager-backend:
    image: ${REGISTRY:-localhost:5000}/addp-manager-backend:${IMAGE_TAG:-latest}
    container_name: addp-manager-backend
    environment:
      - PORT=8081
      - DB_SCHEMA=manager
      - SYSTEM_SERVICE_URL=http://system-backend:8080
      - ENABLE_SERVICE_INTEGRATION=true
      - GIN_MODE=release
    ports:
      - "8081:8081"
    networks:
      - addp-network
    depends_on:
      postgres:
        condition: service_healthy
      system-backend:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/health"]
      interval: 10s
      timeout: 5s
      retries: 5
    profiles:
      - full

  manager-frontend:
    image: ${REGISTRY:-localhost:5000}/addp-manager-frontend:${IMAGE_TAG:-latest}
    container_name: addp-manager-frontend
    ports:
      - "8091:80"
    networks:
      - addp-network
    depends_on:
      - manager-backend
    restart: unless-stopped
    profiles:
      - full

  # ==================== Meta 模块 ====================

  meta-backend:
    image: ${REGISTRY:-localhost:5000}/addp-meta-backend:${IMAGE_TAG:-latest}
    container_name: addp-meta-backend
    environment:
      - PORT=8082
      - DB_SCHEMA=metadata
      - SYSTEM_SERVICE_URL=http://system-backend:8080
      - ENABLE_SERVICE_INTEGRATION=true
      - GIN_MODE=release
    ports:
      - "8082:8082"
    networks:
      - addp-network
    depends_on:
      postgres:
        condition: service_healthy
      system-backend:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8082/health"]
      interval: 10s
      timeout: 5s
      retries: 5
    profiles:
      - full

  # ==================== Gateway 服务 ====================

  gateway:
    image: ${REGISTRY:-localhost:5000}/addp-gateway:${IMAGE_TAG:-latest}
    container_name: addp-gateway
    environment:
      - PORT=8000
      - SYSTEM_SERVICE_URL=http://system-backend:8080
      - MANAGER_SERVICE_URL=http://manager-backend:8081
      - META_SERVICE_URL=http://meta-backend:8082
      - GIN_MODE=release
    ports:
      - "8000:8000"
    networks:
      - addp-network
    depends_on:
      system-backend:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 10s
      timeout: 5s
      retries: 5
    profiles:
      - full

  # ==================== Portal 统一门户 ====================

  portal:
    image: ${REGISTRY:-localhost:5000}/addp-portal:${IMAGE_TAG:-latest}
    container_name: addp-portal
    ports:
      - "5170:80"
    networks:
      - addp-network
    depends_on:
      - gateway
    restart: unless-stopped
    profiles:
      - full

networks:
  addp-network:
    driver: bridge

volumes:
  postgres_data:
  redis_data:
  minio_system_data:
  elasticsearch_data:
  system_data:
