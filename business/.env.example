# Business Infrastructure Configuration
# 业务基础设施配置文件
#
# 注意：变量名使用 BUSINESS_ 前缀以避免与主 ADDP 项目的 .env 文件冲突

# PostgreSQL Configuration
BUSINESS_POSTGRES_USER=business
BUSINESS_POSTGRES_PASSWORD=business_password
BUSINESS_POSTGRES_DB=business
BUSINESS_POSTGRES_PORT=5433  # 使用5433端口避免与ADDP系统数据库冲突

# PostgreSQL Image Selection (自动检测CPU架构)
# 留空则由启动脚本自动检测:
#   - ARM64 (aarch64/arm64): imresamu/postgis-arm64:15-3.4
#   - AMD64 (x86_64): postgis/postgis:15-3.4
# 如需手动指定镜像，可取消注释以下行:
# POSTGRES_IMAGE=postgis/postgis:15-3.4

# MinIO Configuration
BUSINESS_MINIO_ROOT_USER=minioadmin
BUSINESS_MINIO_ROOT_PASSWORD=minioadmin
BUSINESS_MINIO_API_PORT=9002      # 业务 MinIO 使用 9002 端口（系统 MinIO 使用 9000）
BUSINESS_MINIO_CONSOLE_PORT=9003  # 业务 MinIO Console 使用 9003 端口（系统 MinIO Console 使用 9001）
