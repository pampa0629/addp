# Business Infrastructure Configuration
# 业务基础设施配置文件
#
# 注意：变量名使用 BUSINESS_ 前缀以避免与主 ADDP 项目的 .env 文件冲突

# PostgreSQL Configuration
BUSINESS_POSTGRES_USER=business
BUSINESS_POSTGRES_PASSWORD=business_password
BUSINESS_POSTGRES_DB=business
BUSINESS_POSTGRES_PORT=5433  # 使用5433端口避免与ADDP系统数据库冲突

# MinIO Configuration
BUSINESS_MINIO_ROOT_USER=minioadmin
BUSINESS_MINIO_ROOT_PASSWORD=minioadmin
BUSINESS_MINIO_API_PORT=9000      # 使用9000端口避免与ADDP系统MinIO冲突
BUSINESS_MINIO_CONSOLE_PORT=9001  # 使用9001端口避免冲突
