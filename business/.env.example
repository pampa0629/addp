# Business Database Configuration
# 业务库配置文件
#
# 使用方法:
#   cp .env.example .env
#   # 编辑 .env 修改密码等配置
#   docker-compose up -d

# ==================== PostgreSQL ====================
POSTGRES_USER=business
POSTGRES_PASSWORD=business_password  # ⚠️ 生产环境必须修改！
POSTGRES_DB=business
POSTGRES_PORT=5433  # 避免与 ADDP 系统库端口 5432 冲突

# PostgreSQL 镜像（留空自动检测架构）
# ARM64: imresamu/postgis-arm64:15-3.4
# AMD64: postgis/postgis:15-3.4
POSTGRES_IMAGE=

# ==================== SuperMap SDX+ for PostgreSQL ====================
# 独立原生 PostgreSQL 实例；禁止安装 PostGIS，工作区由 SuperMap Workflow 初始化。
SUPERMAP_POSTGRESQL_USER=supermap
SUPERMAP_POSTGRESQL_PASSWORD=supermap_password  # 生产环境必须修改！
SUPERMAP_POSTGRESQL_DB=supermap
SUPERMAP_POSTGRESQL_PORT=5434
SUPERMAP_POSTGRESQL_IMAGE=postgres:15

# ==================== MinIO ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin  # ⚠️ 生产环境必须修改！
MINIO_API_PORT=9002      # 业务库 MinIO API（系统库 MinIO: 9000）
MINIO_CONSOLE_PORT=9003  # 业务库 MinIO Console（系统库 MinIO: 9001）

# ==================== ClickHouse ====================
CLICKHOUSE_DB=business
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=  # 留空表示无密码，生产环境建议设置密码
CLICKHOUSE_PORT=9000       # ClickHouse Native 协议端口
CLICKHOUSE_HTTP_PORT=8123  # ClickHouse HTTP 接口端口

# ==================== MongoDB ====================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin_password  # ⚠️ 生产环境必须修改！
MONGO_DB=business
MONGO_PORT=27017

# ==================== MySQL ====================
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=business
MYSQL_PORT=3306
MYSQL_CDC_USER=addp_cdc
MYSQL_CDC_PASSWORD=addp_cdc_password  # 生产环境必须修改，且不要与 root 密码复用

# ==================== Business Kafka / Redpanda ====================
BUSINESS_KAFKA_PORT=29092
BUSINESS_KAFKA_ADMIN_USERNAME=admin
BUSINESS_KAFKA_ADMIN_PASSWORD=addp_business_kafka_admin  # 生产环境必须修改！
BUSINESS_KAFKA_READER_USERNAME=addp_transfer
BUSINESS_KAFKA_READER_PASSWORD=addp_business_kafka_reader  # 生产环境必须修改！

# ==================== Apache Doris ====================
DORIS_FE_PORT=9030      # Doris FE MySQL 协议端口
DORIS_FE_HTTP_PORT=8030 # Doris FE HTTP API 端口
DORIS_RECOVERY=false    # 仅在迁移 FE 持久元数据地址时临时设为 true

# ==================== Apache Spark ====================
SPARK_MASTER_PORT=7077   # Spark 集群通信端口
SPARK_MASTER_UI=18088    # Spark Master Web UI
SPARK_THRIFT_PORT=11000  # Spark Thrift Server (SQL 接口)

# ==================== 生产环境安全建议 ====================
# 1. 使用强密码: openssl rand -base64 32
# 2. 定期备份数据
# 3. 限制网络访问（仅允许 ADDP 系统访问）
# 4. 定期更新密码
