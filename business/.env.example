# Business Database Configuration
# 业务库配置文件
#
# 使用方法:
#   cp .env.example .env
#   # 编辑 .env 修改密码等配置
#   docker-compose up -d

# ==================== Business FalkorDB ====================
# Business FalkorDB 使用独立密码；启动前填写，不能复用 Infra 密码。
BUSINESS_FALKORDB_PORT=6381
BUSINESS_FALKORDB_PASSWORD=

# ==================== Business Redis ====================
# Business Redis 独立于根 .env 的 Infra REDIS_* 配置。
BUSINESS_REDIS_PORT=6380
BUSINESS_REDIS_ADMIN_PASSWORD=addp_business_redis_admin
BUSINESS_REDIS_READER_PASSWORD=addp_business_redis_reader

# ==================== PostgreSQL ====================
POSTGRES_USER=business
POSTGRES_PASSWORD=business_password  # ⚠️ 生产环境必须修改！
POSTGRES_DB=business
POSTGRES_PORT=5433  # 避免与 ADDP 系统库端口 5432 冲突

# PostgreSQL 镜像（留空自动检测架构）
# ARM64: imresamu/postgis-arm64:15-3.4
# AMD64: postgis/postgis:15-3.4
POSTGRES_IMAGE=

# ==================== Oracle Free ====================
# 使用常规镜像保留 Oracle Spatial；不得切换到会卸载 Spatial/Locator 的 -slim 镜像。
ORACLE_IMAGE=gvenzl/oracle-free:23
ORACLE_SYS_PASSWORD=oracle_sys_password  # 生产环境必须修改！
ORACLE_APP_USER=business
ORACLE_APP_PASSWORD=business_oracle_password  # 生产环境必须修改！
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_PORT=15210
ORACLE_CDC_USER=C##ADDP_CDC
ORACLE_CDC_PASSWORD=addp_oracle_cdc_password  # 生产环境必须修改，且不要与业务账号密码复用
ORACLE_CDC_DATABASE_NAME=FREE

# ==================== SuperMap SDX+ for PostgreSQL ====================
# 独立原生 PostgreSQL 实例；禁止安装 PostGIS，工作区由 SuperMap Workflow 初始化。
SUPERMAP_POSTGRESQL_USER=supermap
SUPERMAP_POSTGRESQL_PASSWORD=supermap_password  # 生产环境必须修改！
SUPERMAP_POSTGRESQL_DB=supermap
SUPERMAP_POSTGRESQL_PORT=5434
SUPERMAP_POSTGRESQL_IMAGE=postgres:15

# ==================== MinIO ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin  # ⚠️ 生产环境必须修改！
MINIO_BIND_HOST=0.0.0.0 # Online Fixture 显式使用 127.0.0.1
MINIO_API_PORT=9002      # 业务库 MinIO API（系统库 MinIO: 9000）
MINIO_CONSOLE_PORT=9003  # 业务库 MinIO Console（系统库 MinIO: 9001）

# ==================== ClickHouse ====================
CLICKHOUSE_DB=business
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=  # 留空表示无密码，生产环境建议设置密码
CLICKHOUSE_PORT=9000       # ClickHouse Native 协议端口
CLICKHOUSE_HTTP_PORT=8123  # ClickHouse HTTP 接口端口

# ==================== MongoDB ====================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin_password  # ⚠️ 生产环境必须修改！
MONGO_DB=business
MONGO_PORT=27017

# ==================== MySQL ====================
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=business
MYSQL_PORT=3306
MYSQL_CDC_USER=addp_cdc
MYSQL_CDC_PASSWORD=addp_cdc_password  # 生产环境必须修改，且不要与 root 密码复用

# ==================== OceanBase CE ====================
# Apache 2.0 的 Community Edition；固定 LTS tag 确保环境可重现。
# MODE=mini 仍建议至少 2 CPU / 8 GB 可用内存。
OCEANBASE_IMAGE=oceanbase/oceanbase-ce:4.4.2-lts
OCEANBASE_MODE=mini
OCEANBASE_TENANT_NAME=test
OCEANBASE_PASSWORD=business_oceanbase_password  # 生产环境必须修改！
OCEANBASE_DATABASE=business
OCEANBASE_PORT=2881

# ==================== TiDB ====================
# PingCAP 官方三组件镜像在 Compose 中固定为 8.5.8 与 OCI digest，不提供覆盖入口。
TIDB_DATABASE=business
TIDB_USER=root
TIDB_PASSWORD=
TIDB_PORT=4000

# ==================== openGauss ====================
# Apache 2.0；start.sh 按主机架构下载并校验 6.0.6 LTS 官方 Docker tar。
# 首次下载约 1.2 GB（ARM64）或 1.4 GB（AMD64），之后复用本地镜像。
OPENGAUSS_PASSWORD=AddpGauss606@  # 生产环境必须修改！需满足 openGauss 密码复杂度
OPENGAUSS_DATABASE=business
OPENGAUSS_PORT=5435

# ==================== Business Kafka / Redpanda ====================
BUSINESS_KAFKA_PORT=29092
BUSINESS_KAFKA_ADMIN_USERNAME=admin
BUSINESS_KAFKA_ADMIN_PASSWORD=addp_business_kafka_admin  # 生产环境必须修改！
BUSINESS_KAFKA_READER_USERNAME=addp_transfer
BUSINESS_KAFKA_READER_PASSWORD=addp_business_kafka_reader  # 生产环境必须修改！

# ==================== Apache Doris ====================
DORIS_FE_PORT=9030      # Doris FE MySQL 协议端口
DORIS_FE_HTTP_PORT=8030 # Doris FE HTTP API 端口
# FE/BE 仅绑定回环；BE 8040/9050/9060/8060 固定内外一致，不自动漂移。
DORIS_RECOVERY=false    # 仅在迁移 FE 持久元数据地址时临时设为 true

# ==================== Apache Spark ====================
SPARK_MASTER_PORT=7077   # Spark 集群通信端口
SPARK_MASTER_UI=18088    # Spark Master Web UI
SPARK_THRIFT_PORT=11000  # Spark Thrift Server (SQL 接口)

# ==================== 生产环境安全建议 ====================
# 1. 使用强密码: openssl rand -base64 32
# 2. 定期备份数据
# 3. 限制网络访问（仅允许 ADDP 系统访问）
# 4. 定期更新密码

# Elasticsearch 9.5.4：本地回环 HTTP + Basic 认证；对外部署应配置 HTTPS。
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_PASSWORD=addp_business_elastic_admin
ELASTICSEARCH_READER_USER=addp_business_reader
ELASTICSEARCH_READER_PASSWORD=addp_business_elastic_reader

# HDFS Simple 本机 Docker Desktop 实验集群；四个端口仅发布到回环地址。
# 宿主机须配置 127.0.0.1 host.docker.internal；容器使用 Docker 内置解析。
# DataNode 与 System RPC 使用这一稳定主机名，端口冲突直接失败。
HDFS_WEB_PORT=9870
HDFS_RPC_PORT=8020
HDFS_DATA_PORT=9866
HDFS_DATA_HTTP_PORT=9864

# 瀚高独立 profile，不进入 -all。管理员密码仅首次建卷写入；业务账号幂等初始化。
HIGHGO_PORT=5866
HIGHGO_PASSWORD=  # 三权管理员密码；必须满足瀚高策略，不得包含换行
HIGHGO_USER=business
HIGHGO_APP_PASSWORD=  # 独立业务密码；必须满足瀚高策略，不得包含换行
HIGHGO_APP_VALID_UNTIL=  # 留空保留原生有效期；明确确认后可设 infinity
