# Business Infrastructure - Production Environment Configuration
# 业务基础设施 - 生产环境配置
#
# ⚠️  重要: 生产环境必须修改所有默认密码！

# ==================== PostgreSQL 配置 ====================
# 业务数据库配置（存储用户实际业务数据）
BUSINESS_POSTGRES_USER=business
BUSINESS_POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION
BUSINESS_POSTGRES_DB=business
BUSINESS_POSTGRES_PORT=5433  # 避免与 ADDP 系统数据库端口冲突（ADDP 使用 5432）

# PostgreSQL 镜像选择（根据CPU架构自动检测）
# 留空则由部署脚本自动检测服务器架构:
#   - ARM64 (aarch64/arm64): imresamu/postgis-arm64:15-3.4
#   - AMD64 (x86_64): postgis/postgis:15-3.4
# 如需手动指定镜像，可取消注释以下行:
# POSTGRES_IMAGE=postgis/postgis:15-3.4

# ==================== MinIO 配置 ====================
# 业务对象存储配置（存储用户上传的文件）
BUSINESS_MINIO_ROOT_USER=admin
BUSINESS_MINIO_ROOT_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION
BUSINESS_MINIO_API_PORT=9002      # 避免与 ADDP 系统 MinIO 冲突（ADDP 使用 9000）
BUSINESS_MINIO_CONSOLE_PORT=9003  # 避免与 ADDP 系统 MinIO 冲突（ADDP 使用 9001）

# ==================== 生产环境安全建议 ====================
# 1. 使用强密码（至少 16 位，包含大小写字母、数字、特殊字符）
# 2. 定期备份数据库和对象存储
# 3. 限制网络访问（仅允许 ADDP 系统访问）
# 4. 定期更新密码

# ==================== 密码生成示例 ====================
# 使用以下命令生成强密码:
#   openssl rand -base64 32
#
# 示例生成的密码:
#   kX7nJ9mP2qR5sT8vW1yZ3aB4cD6eF0gH1iJ2kL3mN4o=
