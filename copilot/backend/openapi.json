              "$ref": "#/components/schemas/PropertyInfo"
            },
            "title": "Properties",
            "type": "array"
          }
        },
        "required": [
          "name",
          "label"
        ],
        "title": "EntityTypeInfo",
        "type": "object"
      },
      "ExtractedEntity": {
        "description": "抽取出的实体",
        "properties": {
          "confidence": {
            "description": "置信度 0.0~1.0",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "properties": {
            "additionalProperties": true,
            "description": "属性值（必须包含所有 unique=true 的属性）",
            "title": "Properties",
            "type": "object"
          },
          "source_text": {
            "description": "实体在原文中的来源文本片段（约 50 字以内）",
            "title": "Source Text",
            "type": "string"
          },
          "temp_id": {
            "description": "局部临时 ID（供同一 chunk 内的关系引用，格式: e1/e2/...）",
            "title": "Temp Id",
            "type": "string"
          },
          "type": {
            "description": "实体类型名（必须与 OntologySchema 中的 name 一致）",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "temp_id",
          "type",
          "properties",
          "confidence",
          "source_text"
        ],
        "title": "ExtractedEntity",
        "type": "object"
      },
      "ExtractedRelation": {
        "description": "抽取出的关系",
        "properties": {
          "confidence": {
            "description": "置信度 0.0~1.0",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "properties": {
            "additionalProperties": true,
            "description": "关系属性值",
            "title": "Properties",
            "type": "object"
          },
          "source_temp_id": {
            "description": "源实体的 temp_id",
            "title": "Source Temp Id",
            "type": "string"
          },
          "source_text": {
            "description": "关系在原文中的来源文本片段",
            "title": "Source Text",
            "type": "string"
          },
          "target_temp_id": {
            "description": "目标实体的 temp_id",
            "title": "Target Temp Id",
            "type": "string"
          },
          "type": {
            "description": "关系类型名（必须与 OntologySchema 中的 name 一致）",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "source_temp_id",
          "target_temp_id",
          "confidence",
          "source_text"
        ],
        "title": "ExtractedRelation",
        "type": "object"
      },
      "HTTPValidationError": {
