{
  "components": {
    "schemas": {
      "DataSourceCandidate": {
        "description": "数据源候选",
        "properties": {
          "engine_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine Id"
          },
          "engine_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine Name"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "schema_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Name"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "table_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Table Name"
          }
        },
        "required": [
          "score",
          "reason"
        ],
        "title": "DataSourceCandidate",
        "type": "object"
      },
      "EntityTypeInfo": {
        "description": "实体类型定义（来自本体模型）",
        "properties": {
          "description": {
            "default": "",
            "description": "实体类型说明",
            "title": "Description",
            "type": "string"
          },
          "label": {
            "description": "显示名称",
            "title": "Label",
            "type": "string"
          },
          "name": {
            "description": "实体类型名（对应 Neo4j Label）",
            "title": "Name",
            "type": "string"
          },
          "properties": {
            "description": "属性定义列表（含 unique 标记）",
