    "/kg-build/extract": {
      "post": {
        "description": "从单个文本 chunk 抽取实体和关系\n\n- 文本分块由 Graph 后端负责（见 graph/backend/internal/service/build_service.go）\n- 此端点只处理单个 chunk（约 1000 字符）\n- 抽取结果的置信度分类和写入 Neo4j 由 Graph 后端负责",
        "operationId": "extract_from_chunk_api_v1_copilot_kg_build_extract_post",
        "parameters": [
          {
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Accept-Language"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KGExtractRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KGExtractResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
