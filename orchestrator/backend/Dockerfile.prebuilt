FROM localhost:5001/alpine:latest

# Build arguments for precise binary selection
ARG BUILD_ARCH=amd64
ARG BUILD_TYPE=release
ARG GOOS=linux

WORKDIR /app

# 复制本地编译好的二进制文件（从扁平化 dist/ 目录）
# 路径: dist/{build}-{os}-{arch}/orchestrator
COPY dist/${BUILD_TYPE}-${GOOS}-${BUILD_ARCH}/orchestrator ./server
RUN chmod +x ./server

# 暴露端口
EXPOSE 8084

# 运行
CMD ["./server"]
