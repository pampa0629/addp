datasources:
  - id: "buildings_test"
    name: "测试建筑物数据"
    type: "postgis"
    connection:
      schema: "public"
      table: "buildings"
      geometry_column: "geom"
      srid: 4326

    tile_config:
      min_zoom: 10
      max_zoom: 18
      buffer: 64
      extent: 4096
      simplification: 0.5

    properties:
      - name: "name"
        type: "string"
      - name: "height"
        type: "number"
      - name: "floors"
        type: "integer"

    filters: []
