datasources:
  - id: "buildings_test"
    name: "测试建筑物数据"
    type: "postgis"
    connection:
      schema: "public"
      table: "buildings"
      geometry_column: "geom"
      srid: 4326

    tile_config:
      min_zoom: 10
      max_zoom: 18
      buffer: 64
      extent: 4096
      simplification: 0.5
      min_px_line: 1.0
      min_px_poly: 3.0
      pixel_rules:
        - min_zoom: 10
          max_zoom: 12
          min_px_line: 2.0
          min_px_poly: 6.0
        - min_zoom: 13
          max_zoom: 14
          min_px_line: 1.5
          min_px_poly: 4.0

    properties:
      - name: "name"
        type: "string"
      - name: "height"
        type: "number"
      - name: "floors"
        type: "integer"

    filters: []
