# DashScope API（通义千问多模态向量化服务）
# 获取 API Key: https://dashscope.console.aliyun.com/apiKey
EMBEDDING_SERVICE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
EMBEDDING_SERVICE_API_KEY=your-api-key-here

# PostgreSQL（独立容器，端口 5436，避免与 ADDP 主系统冲突）
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5436
VECTOR_DB_USER=vector_user
VECTOR_DB_PASSWORD=vector_pass_2025
VECTOR_DB_NAME=vector_db
VECTOR_DB_SCHEMA=vector_store
VECTOR_DB_TABLE=embeddings
VECTOR_DB_SSL_MODE=disable

# 向量维度（首次运行后自动检测并更新）
# 0 表示自动检测维度
VECTOR_DIMENSION=0

# 日志级别（debug|info|warn|error）
LOG_LEVEL=info
