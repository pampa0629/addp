          "role": {
            "const": "tool",
            "default": "tool",
            "title": "Role",
            "type": "string"
          },
          "toolCallId": {
            "title": "Toolcallid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "content",
          "toolCallId"
        ],
        "title": "ToolMessage",
        "type": "object"
      },
      "UserMessage": {
        "additionalProperties": true,
        "description": "A user message supporting text or multimodal content.",
        "properties": {
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "discriminator": {
                    "mapping": {
                      "audio": "#/components/schemas/AudioInputContent",
                      "binary": "#/components/schemas/BinaryInputContent",
                      "document": "#/components/schemas/DocumentInputContent",
                      "image": "#/components/schemas/ImageInputContent",
                      "text": "#/components/schemas/TextInputContent",
                      "video": "#/components/schemas/VideoInputContent"
                    },
                    "propertyName": "type"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TextInputContent"
                    },
                    {
                      "$ref": "#/components/schemas/ImageInputContent"
                    },
                    {
                      "$ref": "#/components/schemas/AudioInputContent"
                    },
                    {
                      "$ref": "#/components/schemas/VideoInputContent"
                    },
                    {
                      "$ref": "#/components/schemas/DocumentInputContent"
                    },
                    {
                      "$ref": "#/components/schemas/BinaryInputContent"
                    }
                  ]
                },
                "type": "array"
              }
            ],
            "title": "Content"
          },
          "encryptedValue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Encryptedvalue"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "role": {
            "const": "user",
            "default": "user",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "content"
        ],
        "title": "UserMessage",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VideoInputContent": {
        "additionalProperties": true,
        "description": "A video input content fragment.",
        "properties": {
          "metadata": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          },
          "source": {
            "discriminator": {
              "mapping": {
                "data": "#/components/schemas/InputContentDataSource",
                "url": "#/components/schemas/InputContentUrlSource"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/InputContentDataSource"
              },
              {
                "$ref": "#/components/schemas/InputContentUrlSource"
              }
            ],
            "title": "Source"
          },
          "type": {
            "const": "video",
            "default": "video",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "title": "VideoInputContent",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "description": "ADDP 用户访问令牌：Authorization: Bearer <token> | ADDP User Access Token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "ADDP 平台智能体服务 | ADDP Platform Agent Service",
    "title": "ADDP Agent Service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/agent/chat": {
      "post": {
        "description": "接收标准 AG-UI RunAgentInput，并以 text/event-stream 返回 AG-UI 事件。",
        "operationId": "chat_api_v1_agent_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunAgentInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "运行智能体 | Run Agent",
        "tags": [
          "对话 | Chat"
        ],
        "x-addp-auth-mode": "permission",
        "x-addp-required-permissions": [
          "agent.run.create",
          "agent.run.execute"
        ],
        "x-ai-hint": "使用 threadId 指定已有 ADDP Agent 会话；messages 中最后一条 user 消息是本次新输入。"
      }
    },
    "/api/v1/agent/runs/{agent_run_id}": {
      "get": {
        "description": "返回当前用户拥有的 AgentRun、语义检查点和受限步骤审计记录。",
        "operationId": "get_agent_run_api_v1_agent_runs__agent_run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "agent_run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Agent Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "AgentRun 不存在 | Agent run not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "获取智能体运行 | Get agent run",
        "tags": [
          "智能体运行 | Agent Runs"
        ],
        "x-addp-auth-mode": "permission",
        "x-addp-required-permissions": [
          "agent.run.read"
        ],
        "x-ai-hint": "agent_run_id 来自 AG-UI STATE_SNAPSHOT.agentRunId；该资源不是 owner 模块 execution。"
      }
    },
    "/api/v1/agent/runs/{agent_run_id}/cancel": {
      "post": {
        "description": "取消内置 Agent Runtime 和待处理 Interaction，不取消 owner 模块 execution。",
        "operationId": "cancel_owned_agent_run_api_v1_agent_runs__agent_run_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "agent_run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Agent Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunActionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "取消智能体运行 | Cancel agent run",
        "tags": [
          "智能体运行 | Agent Runs"
        ],
        "x-addp-auth-mode": "permission",
        "x-addp-required-permissions": [
          "agent.run.cancel"
        ],
        "x-ai-hint": "只允许 running 或 waiting 的 AgentRun；cancelled 是终态。"
      }
    },
    "/api/v1/agent/runs/{agent_run_id}/events": {
      "get": {
        "description": "按 AgentRun 内 sequence 回放当前用户可见的安全 AG-UI 事件。",
        "operationId": "replay_agent_run_events_api_v1_agent_runs__agent_run_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "agent_run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Agent Run Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "After",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "重放智能体运行事件 | Replay agent run events",
        "tags": [
          "智能体运行 | Agent Runs"
        ],
        "x-addp-auth-mode": "permission",
        "x-addp-required-permissions": [
          "agent.run.read"
        ],
        "x-ai-hint": "after 是客户端最后已处理的 AgentRunEvent sequence；Tool 参数和原始结果不会出现在重放流中。"
      }
    },
    "/api/v1/agent/runs/{agent_run_id}/retry": {
      "post": {
        "description": "仅重试失败的 AgentRun，并以新的协议调用 ID 返回 AG-UI SSE；不会创建第二个 AgentRun。",
        "operationId": "retry_chat_api_v1_agent_runs__agent_run_id__retry_post",
        "parameters": [
          {
            "in": "path",
            "name": "agent_run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Agent Run Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetryAgentRunInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "重试智能体运行 | Retry agent run",
        "tags": [
          "对话 | Chat"
        ],
        "x-addp-auth-mode": "permission",
        "x-addp-required-permissions": [
          "agent.run.execute"
        ],
        "x-ai-hint": "runId 是本次重试的协议调用 ID；仅接受 failed AgentRun，取消态不允许重试。"
      }
    },
