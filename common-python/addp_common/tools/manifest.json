{
  "schema": "addp.tool-manifest/v1",
  "version": "1.0.0",
  "tools": [
    {
      "name": "engine.list",
      "version": "1.0.0",
      "description": "查询当前用户可访问的引擎实例，可限定为工作流运行时。",
      "owner": "system",
      "risk": "read",
      "approval": {"mode": "none"},
      "auth": {"type": "delegated_access_token", "audience": "system", "required_scopes": ["engine.list"], "required_permissions": ["system.engine.read"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "owner"},
      "result_ref": {"mode": "none"},
      "limits": {"max_bytes": 131072},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {"capability": {"type": "string", "enum": ["all", "workflow"], "default": "all"}},
        "additionalProperties": false
      },
      "output_schema": {"type": "array", "items": {"type": "object"}}
    },
    {
      "name": "data.search",
      "version": "1.0.0",
      "description": "搜索当前租户已有数据项并返回稳定 locator 候选。",
      "owner": "manager",
      "risk": "read",
      "approval": {"mode": "none"},
      "auth": {"type": "delegated_access_token", "audience": "manager", "required_scopes": ["data.search"], "required_permissions": ["manager.search.execute"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "owner"},
      "result_ref": {"mode": "locator"},
      "limits": {"max_bytes": 131072},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "minLength": 1},
          "engine_id": {"type": "integer", "minimum": 1},
          "limit": {"type": "integer", "minimum": 1, "maximum": 20, "default": 10}
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    {
      "name": "resource.children.list",
      "version": "1.0.0",
      "description": "校验父资源 locator 并返回其直接子资源的标准资源树投影。",
      "owner": "meta",
      "risk": "read",
      "approval": {"mode": "none"},
      "auth": {"type": "delegated_access_token", "audience": "meta", "required_scopes": ["resource.children.list"], "required_permissions": ["meta.catalog.read"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "owner"},
      "result_ref": {"mode": "locator"},
      "limits": {"max_bytes": 524288},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {
          "engine_id": {"type": "integer", "minimum": 1},
          "parent_locator": {"type": "string", "minLength": 1}
        },
        "required": ["engine_id", "parent_locator"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["locator", "children"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "type": {"type": "string"},
          "children": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    {
      "name": "resource.ancestors.get",
      "version": "1.0.0",
      "description": "按 Meta 当前事实校验 locator 并返回根到目标的祖先链。",
      "owner": "meta",
      "risk": "read",
      "approval": {"mode": "none"},
      "auth": {"type": "delegated_access_token", "audience": "meta", "required_scopes": ["resource.ancestors.get"], "required_permissions": ["meta.catalog.read"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "owner"},
      "result_ref": {"mode": "locator"},
      "limits": {"max_bytes": 131072},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {
          "engine_id": {"type": "integer", "minimum": 1},
          "locator": {"type": "string", "minLength": 1}
        },
        "required": ["engine_id", "locator"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    {
      "name": "resource.facts.get",
      "version": "1.0.0",
      "description": "按 locator 返回不含原始数据行的受限资源、Schema 与查询事实。",
      "owner": "manager",
      "risk": "read",
      "approval": {"mode": "none"},
      "auth": {"type": "delegated_access_token", "audience": "manager", "required_scopes": ["resource.facts.get"], "required_permissions": ["manager.data_item.read"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "owner"},
      "result_ref": {"mode": "locator"},
      "limits": {"max_bytes": 131072},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {"locator": {"type": "string", "minLength": 1}},
        "required": ["locator"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["locator", "engine_id", "source_engine_type", "item_id", "item_type", "data_type", "full_name", "item_fingerprint", "scanned_depth", "schema_coverage", "query_names"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "engine_id": {"type": "integer", "minimum": 1},
          "engine_name": {"type": "string"},
          "source_engine_type": {"type": "string", "minLength": 1},
          "item_id": {"type": "integer", "minimum": 1},
          "item_type": {"type": "string", "minLength": 1},
          "data_type": {"type": "string", "minLength": 1},
          "full_name": {"type": "string", "minLength": 1},
          "item_fingerprint": {"type": "string", "minLength": 1},
          "scanned_depth": {"type": "string", "minLength": 1},
          "schema_coverage": {"enum": ["complete", "sampled", "unknown"]},
          "query_names": {"type": "object", "additionalProperties": {"type": "string"}},
          "fields": {"type": "array", "maxItems": 200, "items": {"type": "object"}},
          "geometry_column": {"type": "string"},
          "geometry_type": {"type": "string"},
          "crs": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    {
      "name": "data.preview",
      "version": "1.0.0",
      "description": "按 locator 返回受限字段、样本和空间事实预览。",
      "owner": "manager",
      "risk": "read",
      "approval": {"mode": "none"},
      "auth": {"type": "delegated_access_token", "audience": "manager", "required_scopes": ["data.preview"], "required_permissions": ["manager.data_item.read"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "owner"},
      "result_ref": {"mode": "locator"},
      "limits": {"max_bytes": 262144},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "limit": {"type": "integer", "minimum": 1, "maximum": 20, "default": 10}
        },
        "required": ["locator"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    {
      "name": "workflow.operators.list",
      "version": "1.0.0",
      "description": "查询具体工作流运行时实例的 Public Operator Spec。",
      "owner": "develop",
      "risk": "read",
      "approval": {"mode": "none"},
      "auth": {"type": "delegated_access_token", "audience": "develop", "required_scopes": ["workflow.operators.list"], "required_permissions": ["develop.task.read"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "owner"},
      "result_ref": {"mode": "none"},
      "limits": {"max_bytes": 524288},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {"workflow_engine_id": {"type": "integer", "minimum": 1}},
        "required": ["workflow_engine_id"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["workflow_engine_id", "count", "operators"]
      }
    },
    {
      "name": "workflow.draft.generate",
      "version": "1.0.0",
      "description": "根据自然语言、目标运行时和已验证的多资源事实生成候选 workflow definition。",
      "owner": "copilot",
      "risk": "propose",
      "approval": {"mode": "none"},
      "auth": {"type": "delegated_access_token", "audience": "copilot", "required_scopes": ["workflow.draft.generate"], "required_permissions": ["copilot.workflow.execute"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "owner"},
      "result_ref": {"mode": "none"},
      "limits": {"max_bytes": 262144},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "minLength": 1},
          "workflow_engine_id": {"type": "integer", "minimum": 1},
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {"type": "string", "minLength": 1},
                "locator": {"type": "string", "minLength": 1},
                "data_type": {"type": "string"},
                "geometry_column": {"type": ["string", "null"]},
                "geometry_type": {"type": ["string", "null"]},
                "crs": {"type": ["string", "null"]},
                "fields": {"type": "array", "items": {"type": "object"}, "maxItems": 200}
              },
              "required": ["role", "locator"],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 20
          }
        },
        "required": ["query", "workflow_engine_id", "resources"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "required": ["status"]}
    },
    {
      "name": "query.draft.generate",
      "version": "1.0.0",
      "description": "根据当前查询引擎、查询语言和已验证资源事实生成候选查询文本及参数定义，不执行查询。",
      "owner": "copilot",
      "risk": "propose",
      "approval": {"mode": "none"},
      "auth": {"type": "delegated_access_token", "audience": "copilot", "required_scopes": ["query.draft.generate"], "required_permissions": ["copilot.sql.execute"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "owner"},
      "result_ref": {"mode": "none"},
      "limits": {"max_bytes": 262144},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "minLength": 1},
          "engine_id": {"type": "integer", "minimum": 1},
          "query_language": {"type": "string", "minLength": 1},
          "engine_context": {"type": "object"},
          "current_query": {"type": ["string", "null"], "maxLength": 200000},
          "resource_scope_locator": {"type": ["string", "null"], "minLength": 1},
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {"type": "string", "minLength": 1},
                "locator": {"type": "string", "minLength": 1},
                "engine_id": {"type": "integer", "minimum": 1},
                "data_type": {"type": ["string", "null"]},
                "geometry_column": {"type": ["string", "null"]},
                "geometry_type": {"type": ["string", "null"]},
                "crs": {"type": ["string", "null"]},
                "fields": {"type": "array", "items": {"type": "object"}, "maxItems": 200}
              },
              "required": ["role", "locator", "engine_id"],
              "additionalProperties": false
            },
            "maxItems": 20
          }
        },
        "required": ["query", "engine_id", "query_language", "engine_context", "resources"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {"type": "string"},
          "query": {"type": ["string", "null"]},
          "query_language": {"type": "string"},
          "query_parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
                "type": {"enum": ["string", "integer", "number", "boolean"]},
                "default": {},
                "title": {"type": "string"},
                "description": {"type": "string"}
              },
              "required": ["name", "type", "default"],
              "additionalProperties": false
            }
          }
        },
        "required": ["status", "query_language", "query_parameters"]
      }
    },
    {
      "name": "notebook.draft.generate",
      "version": "1.0.0",
      "description": "根据 Notebook Session 已限定的 Catalog 候选或已验证资源事实生成候选 Python 单元，不执行代码。",
      "owner": "copilot",
      "risk": "propose",
      "approval": {"mode": "none"},
      "auth": {"type": "delegated_access_token", "audience": "copilot", "required_scopes": ["notebook.draft.generate"], "required_permissions": ["copilot.notebook.execute"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "owner"},
      "result_ref": {"mode": "none"},
      "limits": {"max_bytes": 524288},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "minLength": 1},
          "kernel": {"const": "python3", "default": "python3"},
          "candidates": {"type": "array", "items": {"type": "object"}, "maxItems": 320},
          "resources": {"type": "array", "items": {"type": "object"}, "maxItems": 8}
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "required": ["status"]}
    },
    {
      "name": "transfer.draft.generate",
      "version": "1.0.0",
      "description": "发现并确认单一源资源，在 Transfer 已确认目标和任务边界内生成不带副作用的任务草稿。",
      "owner": "copilot",
      "risk": "propose",
      "approval": {"mode": "none"},
      "auth": {"type": "delegated_access_token", "audience": "copilot", "required_scopes": ["transfer.draft.generate"], "required_permissions": ["copilot.transfer.execute"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "owner"},
      "result_ref": {"mode": "none"},
      "limits": {"max_bytes": 262144},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "minLength": 1},
          "resources": {"type": "array", "items": {"type": "object"}, "maxItems": 1},
          "task": {"type": ["object", "null"]}
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "required": ["status"]}
    },
    {
      "name": "workflow.validate",
      "version": "1.0.0",
      "description": "按 addp.workflow/v1 和目标运行时 Public Operator Spec 校验候选 definition。",
      "owner": "develop",
      "risk": "read",
      "approval": {"mode": "none"},
      "auth": {"type": "delegated_access_token", "audience": "develop", "required_scopes": ["workflow.validate"], "required_permissions": ["develop.task.execute"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "owner"},
      "result_ref": {"mode": "none"},
      "limits": {"max_bytes": 131072},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {
          "workflow_engine_id": {"type": "integer", "minimum": 1},
          "workflow_definition": {"type": "object"}
        },
        "required": ["workflow_engine_id", "workflow_definition"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "required": ["valid", "workflow_engine_id", "errors", "warnings"]}
    },
    {
      "name": "workflow.run",
      "version": "1.0.0",
      "description": "首次向 Develop 提交已校验的 workflow definition 并创建 owner approval；批准后仅使用 approval_id 与 request_fingerprint 创建 execution。",
      "owner": "develop",
      "risk": "write",
      "approval": {"mode": "owner_policy"},
      "auth": {"type": "delegated_access_token", "audience": "develop", "required_scopes": ["workflow.run"], "required_permissions": ["develop.task.execute"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "required"},
      "result_ref": {"mode": "execution", "schema": "addp.result-ref/v1"},
      "limits": {"max_bytes": 65536},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "approval_forbidden", "approval_not_found", "approval_not_approved", "approval_rejected", "approval_expired", "approval_request_mismatch", "approval_already_consumed", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {
          "workflow_engine_id": {"type": "integer", "minimum": 1},
          "workflow_definition": {"type": "object"},
          "engine_specific": {"type": "object"},
          "approval_id": {"type": "string", "format": "uuid"},
          "request_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "oneOf": [
          {"required": ["workflow_engine_id", "workflow_definition"], "not": {"anyOf": [{"required": ["approval_id"]}, {"required": ["request_fingerprint"]}]}},
          {"required": ["approval_id", "request_fingerprint"], "not": {"anyOf": [{"required": ["workflow_engine_id"]}, {"required": ["workflow_definition"]}, {"required": ["engine_specific"]}]}}
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "oneOf": [
          {"required": ["execution_id"]},
          {"required": ["status", "interaction_id", "open_url", "request_fingerprint", "request_summary", "expires_at"], "properties": {"status": {"const": "approval_required"}}}
        ]
      }
    },
    {
      "name": "execution.get",
      "version": "1.0.0",
      "description": "查询 Develop execution 的状态、进度和受限结果摘要。",
      "owner": "develop",
      "risk": "read",
      "approval": {"mode": "none"},
      "auth": {"type": "delegated_access_token", "audience": "develop", "required_scopes": ["execution.get"], "required_permissions": ["develop.task.read"]},
      "permission_enforced_by": "owner",
      "audit": {"mode": "owner"},
      "result_ref": {"mode": "execution", "schema": "addp.result-ref/v1"},
      "limits": {"max_bytes": 131072},
      "errors": ["invalid_arguments", "delegation_rejected", "delegation_unavailable", "invalid_delegation_response", "owner_api_error", "owner_api_unavailable", "invalid_owner_response", "result_too_large"],
      "input_schema": {
        "type": "object",
        "properties": {"execution_id": {"type": "string", "minLength": 1}},
        "required": ["execution_id"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "required": ["execution_id", "status"]}
    }
  ]
}
