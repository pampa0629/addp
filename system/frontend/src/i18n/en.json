  "roles": {
    "platform": {
      "asset_runtime": {
        "name": "Asset Platform Runtime",
        "description": "Registers the Asset module and sends runtime heartbeats without user or tenant business permissions."
      },
      "develop_runtime": {
        "name": "Develop Platform Runtime",
        "description": "Registers the Develop module and task provider without data access permissions."
      },
      "meta_runtime": {
        "name": "Meta Platform Runtime",
        "description": "Registers the Meta module and task provider without user business permissions."
      },
      "orchestrator_runtime": {
        "name": "Orchestrator Platform Runtime",
        "description": "Discovers task providers and registers Orchestrator runtime capabilities."
      },
      "portal_runtime": {
        "name": "Portal Platform Runtime",
        "description": "Registers the Portal module and sends runtime heartbeats without user or tenant business permissions."
      }
    },
    "tenant": {
      "administrator": {
        "name": "Tenant Access Administrator",
        "description": "Manages tenant members, invitations, roles, and assignments; excludes infrastructure and business permissions."
      },
      "ai_user": {
        "name": "AI User",
        "description": "Uses Agent sessions and runs, plus Copilot execution capabilities."
      },
      "asset_consumer": {
        "name": "Asset Consumer",
        "description": "Browses published assets, requests access, views service endpoints while authorization is active, and submits ratings."
      },
      "asset_manager": {
        "name": "Asset Manager",
        "description": "Manages asset catalogs, entries, access requests, and ratings."
      },
      "asset_runtime": {
        "name": "Asset Discovery Runtime",
        "description": "Lets Asset read discoverable Meta, Service, Standard, and Develop resources within a tenant."
      },
      "auditor": {
        "name": "Tenant Auditor",
        "description": "Reads and exports tenant audit events with read-only execution and statistics access."
      },
      "data_engineer": {
        "name": "Data Engineer",
        "description": "Manages transfer tasks, development tasks, notebooks, and workflows."
      },
      "data_steward": {
        "name": "Data Steward",
        "description": "Manages data items and derived artifacts, and executes Meta inspection and scan tasks."
      },
      "data_viewer": {
        "name": "Data Viewer",
        "description": "Reads data content, data items, search results, and the Meta catalog."
      },
      "develop_runtime": {
        "name": "Develop Execution Runtime",
        "description": "Consumes user-derived execution authorizations and reads masked runtime descriptors without independent data permissions."
      },
      "governance_manager": {
        "name": "Governance Manager",
        "description": "Manages standards, models, quality rules, check tasks, and quality issues."
      },
      "graph_engineer": {
        "name": "Graph Engineer",
        "description": "Manages ontologies, graphs, build tasks, analysis, and reviews."
      },
      "infrastructure_administrator": {
        "name": "Tenant Infrastructure Administrator",
        "description": "Manages engines, applications, API keys, and resource reclaim, and reads health status."
      },
      "monitoring_operator": {
        "name": "Monitoring Operator",
        "description": "Manages alert rules, incidents, and notification destinations, and reads execution and health status."
      },
      "meta_runtime": {
        "name": "Metadata Scan Runtime",
        "description": "Reads tenant engine connections for metadata scans and writes tenant audit events."
      },
      "orchestrator_runtime": {
        "name": "Task Orchestration Runtime",
        "description": "Calls task providers and resolves execution authorization subjects without independent data permissions."
      },
      "portal_runtime": {
        "name": "Asset Portal Aggregation Runtime",
        "description": "Reads tenant service endpoint projections only after user asset authorization is confirmed, without independent asset access."
      },
      "service_publisher": {
        "name": "Service Publisher",
        "description": "Reads data and the Meta catalog, and manages service definitions and external registrations."
      }
    }
