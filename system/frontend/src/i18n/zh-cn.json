  "roles": {
    "platform": {
      "asset_runtime": {
        "name": "资产服务平台运行时",
        "description": "供 Asset 服务注册模块和发送运行时心跳，不授予用户或租户业务权限。"
      },
      "develop_runtime": {
        "name": "开发服务平台运行时",
        "description": "供 Develop 服务注册模块和任务提供者，不授予数据访问权限。"
      },
      "meta_runtime": {
        "name": "元数据服务平台运行时",
        "description": "供 Meta 服务注册模块和任务提供者，不授予用户业务权限。"
      },
      "orchestrator_runtime": {
        "name": "编排服务平台运行时",
        "description": "供 Orchestrator 发现任务提供者并注册自身运行时能力。"
      },
      "portal_runtime": {
        "name": "资产门户平台运行时",
        "description": "供 Portal 注册模块并发送运行时心跳，不授予用户或租户业务权限。"
      }
    },
    "tenant": {
      "administrator": {
        "name": "租户组织与权限管理员",
        "description": "管理租户成员、邀请、角色与角色分配；不包含基础设施和业务权限。"
      },
      "ai_user": {
        "name": "AI 用户",
        "description": "使用 Agent 会话、运行任务以及 Copilot 执行能力。"
      },
      "asset_consumer": {
        "name": "资产使用者",
        "description": "查看已上架资产、申请授权、在授权有效时查看服务端点并参与评价。"
      },
      "asset_manager": {
        "name": "资产管理员",
        "description": "管理资产目录、条目、授权申请和评价。"
      },
      "asset_runtime": {
        "name": "资产发现运行时",
        "description": "供 Asset 服务按租户读取 Meta、Service、Standard 和 Develop 的可发现资产。"
      },
      "auditor": {
        "name": "租户审计员",
        "description": "查看和导出租户审计事件，并只读查看执行与统计信息。"
      },
      "data_engineer": {
        "name": "数据工程师",
        "description": "管理传输任务、开发任务、Notebook 和工作流。"
      },
      "data_steward": {
        "name": "数据管理员",
        "description": "管理数据条目和衍生物，并执行 Meta 检查与扫描任务。"
      },
      "data_viewer": {
        "name": "数据查看者",
        "description": "只读查看数据内容、数据条目、搜索结果和 Meta Catalog。"
      },
      "develop_runtime": {
        "name": "开发执行运行时",
        "description": "供 Develop 消费用户派生的执行授权并读取脱敏运行时描述，不独立授予数据权限。"
      },
      "governance_manager": {
        "name": "数据治理管理员",
        "description": "管理标准、模型、质量规则、检查任务和质量问题。"
      },
      "graph_engineer": {
        "name": "图谱工程师",
        "description": "管理本体、图谱、构建任务、分析和审核。"
      },
      "infrastructure_administrator": {
        "name": "租户基础设施管理员",
        "description": "管理引擎、应用、API Key 和资源回收，并查看健康状态。"
      },
      "monitoring_operator": {
        "name": "监控运维员",
        "description": "管理告警规则、事件和通知目标，并查看执行与健康状态。"
      },
      "meta_runtime": {
        "name": "元数据扫描运行时",
        "description": "供 Meta 在租户范围内读取引擎连接并写入审计事件。"
      },
      "orchestrator_runtime": {
        "name": "任务编排运行时",
        "description": "供 Orchestrator 调用任务提供者和解析执行授权主体，不独立授予数据权限。"
      },
      "portal_runtime": {
        "name": "资产门户聚合运行时",
        "description": "仅在用户资产授权有效后读取租户服务端点投影，不独立授予资产访问权限。"
      },
      "service_publisher": {
        "name": "数据服务发布者",
        "description": "查看数据与 Meta Catalog，并管理服务定义和外部服务注册。"
      }
    }
  }
