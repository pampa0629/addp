                "schedule_time": {
                    "description": "执行时间 HH:mm（daily/weekly/monthly 时使用）",
                    "type": "string"
                },
                "schedule_type": {
                    "description": "daily, weekly, monthly, cron（仅当scheduled_scan=true时有效）",
