{
  "module": "gateway",
  "title": "API 网关",
  "version": "0.0.20",
  "categories": [
    {
      "name": "路由规则",
      "description": "Gateway 路由配置说明",
      "routes": [
        {
          "name": "System 系统管理",
          "path": "/api/system/*",
          "target": "System Backend",
          "port": "8080",
          "description": "用户认证、日志审计、引擎配置"
        },
        {
          "name": "Manager 数据管理",
          "path": "/api/manager/*",
          "target": "Manager Backend",
          "port": "8081",
          "description": "数据预览、全文搜索、MVT 瓦片"
        },
        {
          "name": "Manager Explorer (新版)",
          "path": "/api/explorer/*",
          "target": "Manager Backend",
          "port": "8081",
          "description": "统一数据探查接口"
        },
        {
          "name": "Meta 元数据",
          "path": "/api/meta/*",
          "target": "Meta Backend",
          "port": "8082",
          "description": "元数据扫描、定时任务、对象存储"
        },
        {
          "name": "Transfer 数据传输",
          "path": "/api/transfer/*",
          "target": "Transfer Backend",
          "port": "8083",
          "description": "数据导入、导出、同步"
        },
        {
          "name": "Develop 数据开发",
          "path": "/api/develop/*",
          "target": "Develop Backend",
          "port": "8085",
          "description": "SQL 查询、工作流执行、Notebook"
        },
        {
          "name": "Service 数据服务",
          "path": "/api/service/*",
          "target": "Service Backend",
          "port": "8088",
          "description": "数据服务发布、OGC 标准接口"
        },
        {
          "name": "Orchestrator 工作流编排",
          "path": "/api/orchestrator/*",
          "target": "Orchestrator Backend",
          "port": "8086",
          "description": "工作流调度、DAG 管理"
        }
      ]
    }
  ]
}
