server {
    listen 3100;
    server_tokens off;
    access_log off;
    client_max_body_size 2m;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $loki_backend http://loki:3100;
    location = /ready {
        proxy_pass $loki_backend/ready;
    }
    location = /loki/api/v1/query_range {
        if ($http_authorization != "Bearer ${LOKI_READ_TOKEN}") { return 401; }
        limit_except GET { deny all; }
        proxy_read_timeout 12s;
        proxy_set_header Authorization "";
        proxy_pass $loki_backend$request_uri;
    }
    location = /loki/api/v1/push {
        if ($http_authorization != "Bearer ${LOKI_WRITE_TOKEN}") { return 401; }
        limit_except POST { deny all; }
        proxy_set_header Authorization "";
        proxy_pass $loki_backend$request_uri;
    }
    location / { return 404; }
}
