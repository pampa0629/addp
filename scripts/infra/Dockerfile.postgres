# ADDP Infrastructure PostgreSQL with pgvector
# 支持多架构：x86_64 和 ARM64
#
# 构建参数：
#   - POSTGRES_BASE_IMAGE: 基础镜像（默认 postgres:15-bookworm，可显式覆盖）
#
# 功能：
#   - PostgreSQL 15 + PostGIS 3
#   - pgvector v0.8.0（向量检索扩展）

# 使用仍受支持的 Debian bookworm 路线，避免旧 bullseye 仓库元数据失效。
ARG POSTGRES_BASE_IMAGE=postgres:15-bookworm
FROM ${POSTGRES_BASE_IMAGE}

# 标签信息
LABEL maintainer="ADDP Team"
LABEL description="PostgreSQL 15 with PostGIS and pgvector for ADDP Infrastructure"
LABEL pgvector.version="0.8.0"

# 安装 PostGIS 运行扩展以及 pgvector 构建依赖。
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    git \
    postgresql-15-postgis-3 \
    postgresql-15-postgis-3-scripts \
    postgresql-server-dev-15 \
    && rm -rf /var/lib/apt/lists/*

# 下载并安装 pgvector v0.8.0
RUN cd /tmp && \
    git clone --branch v0.8.0 https://github.com/pgvector/pgvector.git && \
    cd pgvector && \
    make clean && \
    make OPTFLAGS="" && \
    make install && \
    cd / && \
    rm -rf /tmp/pgvector

# 清理构建依赖（可选，减小镜像大小）
# 注意：保留 postgresql-server-dev-15 可能对某些操作有帮助
RUN apt-get remove -y build-essential git && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 暴露 PostgreSQL 默认端口
EXPOSE 5432

# 使用基础镜像的入口点
# ENTRYPOINT 和 CMD 由基础镜像提供
