FROM golang:1.24-alpine@sha256:8bee1901f1e530bfb4a7850aa7a479d17ae3a18beb6e09064ed54cfd245b7191 AS build
ENV GOWORK=off CGO_ENABLED=0
WORKDIR /src
COPY common/go.mod common/go.sum /src/common/
COPY monitor/backend/go.mod monitor/backend/go.sum /src/monitor/backend/
COPY monitor/backend/internal/redissource /src/monitor/backend/internal/redissource
COPY monitor/backend/internal/sourceserver /src/monitor/backend/internal/sourceserver
COPY monitor/backend/cmd/redis-metrics-source /src/monitor/backend/cmd/redis-metrics-source
WORKDIR /src/monitor/backend
RUN go build -trimpath -o /out/redis-metrics-source ./cmd/redis-metrics-source
FROM scratch
COPY --from=build /out/redis-metrics-source /redis-metrics-source
USER 65532:65532
ENTRYPOINT ["/redis-metrics-source"]
