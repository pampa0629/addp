{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "autoscaling/v2",
      "kind": "HorizontalPodAutoscaler",
      "metadata": {
        "name": "meta-worker"
      },
      "spec": {
        "scaleTargetRef": {
          "apiVersion": "apps/v1",
          "kind": "Deployment",
          "name": "meta-worker"
        },
        "minReplicas": 2,
        "maxReplicas": 6,
        "metrics": [
          {
            "type": "ContainerResource",
            "containerResource": {
              "name": "cpu",
              "container": "meta-worker",
              "target": {
                "type": "Utilization",
                "averageUtilization": 70
              }
            }
          },
          {
            "type": "ContainerResource",
            "containerResource": {
              "name": "memory",
              "container": "meta-worker",
              "target": {
                "type": "Utilization",
                "averageUtilization": 80
              }
            }
          }
        ],
        "behavior": {
          "scaleDown": {
            "stabilizationWindowSeconds": 300
          }
        }
      }
    },
    {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {
        "name": "meta-worker"
      },
      "spec": {
        "minAvailable": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "meta-worker"
          }
        }
      }
    }
  ]
}
