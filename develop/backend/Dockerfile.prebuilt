FROM localhost:5001/ubuntu:24.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates tzdata util-linux && rm -rf /var/lib/apt/lists/*

# Build arguments for precise binary selection
ARG BUILD_ARCH=amd64
ARG BUILD_TYPE=release
ARG GOOS=linux

WORKDIR /app

# 复制本地编译好的二进制文件（从扁平化 dist/ 目录）
# 路径: dist/{build}-{os}-{arch}/develop
COPY dist/${BUILD_TYPE}-${GOOS}-${BUILD_ARCH}/develop ./server
RUN chmod +x ./server

# 暴露端口
EXPOSE 8185

# 运行
CMD ["./server"]

COPY dist/${BUILD_TYPE}-${GOOS}-${BUILD_ARCH}/runtime-log /app/runtime-log
COPY develop/module-declaration.json /app/module-declaration.json
# The receiver keeps the node log owner. Drop privileges before exec of the backend.
ENTRYPOINT ["/app/runtime-log", "launch", "--module", "develop", "--role", "backend", "--", "/usr/bin/setpriv", "--reuid=10001", "--regid=10001", "--clear-groups", "--no-new-privs", "--"]
