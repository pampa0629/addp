# ==================== 全域数据平台配置示例 ====================
# 复制此文件为 .env 并修改配置

# ==================== System 模块配置 ====================

# 目标 IAM 不创建默认 SuperAdmin、默认租户或弱密码账号。
# 首次平台系统管理员、安全管理员和审计管理员只能通过一次性离线 Bootstrap 建立。

# 生产环境使用 `openssl rand -base64 32` 生成，不得与 ENCRYPTION_KEY 复用。
OAUTH_USER_CODE_PEPPER=
# 仅用于受控轮换窗口，过渡完成后删除。
# OAUTH_PREVIOUS_USER_CODE_PEPPER=
# 独立的 Base64 32 字节 MFA Credential 加密密钥；不得与 ENCRYPTION_KEY 复用。
IAM_MFA_ENCRYPTION_KEY=
# 浏览器、CLI 和外部客户端可访问的 Gateway 公共 API 根地址
PUBLIC_API_URL=http://localhost:8000
CONSOLE_URL=http://localhost:5170
# 模块自身与 T4 专用部署使用的回环服务地址；容器部署由编排覆盖。
SYSTEM_URL=http://localhost:8180
GATEWAY_URL=http://localhost:8000
MANAGER_URL=http://localhost:8081
META_URL=http://localhost:8082
CATALOG_URL=http://localhost:8192
WORKBENCH_URL=http://localhost:8193
STANDARD_URL=http://localhost:8110
MODEL_URL=http://localhost:8181
ASSET_URL=http://localhost:8183
PORTAL_URL=http://localhost:8184
SERVICE_URL=http://localhost:8086
# Develop 自身的模块间可达地址，供 Notebook Runtime 回调会话限定接口。
DEVELOP_URL=http://localhost:8185
# DuckDB Federated Query Runtime 监听端口；Runtime 就绪后自行注册到 System。
DUCKDB_RUNTIME_PORT=8104
# 仅存放与当前 DuckDB 版本/平台匹配、由启动或构建阶段准备的扩展。
DUCKDB_EXTENSION_DIRECTORY=.cache/duckdb/extensions
# 容器 Runtime 访问登记为 loopback 的业务 Engine 时使用；本地二进制留空。
DUCKDB_SOURCE_LOOPBACK_HOST=
TRUSTED_PROXIES=127.0.0.1,::1

# CORS 允许的来源（跨域资源共享白名单）
# ⚠️ 生产环境必须配置为实际前端域名！
#
# 用途：控制哪些前端域名可以访问 API，提高安全性
# 格式：逗号分隔的 URL 列表，不包含路径和尾部斜杠
#
# 示例：
#   开发环境: http://localhost:5170,http://localhost:5173
#   生产环境: https://app.example.com,https://www.example.com
#
# 注意事项：
#   - 不要使用通配符 "*"（不安全）
#   - 必须包含协议（http:// 或 https://）
#   - 端口号必须精确匹配
#   - 多个域名用英文逗号分隔，逗号后可有空格
ALLOWED_ORIGINS=http://localhost:5170,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5179,http://localhost:5180,http://localhost:5181,http://localhost:5182,http://localhost:5183,http://localhost:5184,http://localhost:5185,http://localhost:5186,http://localhost:5187,http://localhost:5188,http://localhost:5189,http://localhost:5190

# 内置模块使用各自独立的 OAuth Client Secret 获取 Tenant Service Access Token。
# 每项必须为 32-72 字节且彼此不同；生产环境由 Secret Manager 独立注入。
AGENT_SERVICE_CLIENT_SECRET=replace-with-unique-agent-secret-32bytes
ASSET_SERVICE_CLIENT_SECRET=replace-with-unique-asset-secret-32bytes
CATALOG_SERVICE_CLIENT_SECRET=replace-with-unique-catalog-secret-32bytes
WORKBENCH_SERVICE_CLIENT_SECRET=replace-with-unique-workbench-secret-32bytes
COPILOT_SERVICE_CLIENT_SECRET=replace-with-unique-copilot-secret-32bytes
DEVELOP_SERVICE_CLIENT_SECRET=replace-with-unique-develop-secret-32bytes
DUCKDB_SERVICE_CLIENT_SECRET=replace-with-unique-duckdb-secret-32bytes
GATEWAY_SERVICE_CLIENT_SECRET=replace-with-unique-gateway-secret-32bytes
GRAPH_SERVICE_CLIENT_SECRET=replace-with-unique-graph-secret-32bytes
GEOPYTHON_WORKFLOW_SERVICE_CLIENT_SECRET=replace-with-unique-geopython-secret-32bytes
INFERENCE_SERVICE_CLIENT_SECRET=replace-with-unique-inference-secret-32bytes
MANAGER_SERVICE_CLIENT_SECRET=replace-with-unique-manager-secret-32bytes
META_SERVICE_CLIENT_SECRET=replace-with-unique-meta-secret-32bytes
MODEL_SERVICE_CLIENT_SECRET=replace-with-unique-model-secret-32bytes
MODEL3D_WORKFLOW_SERVICE_CLIENT_SECRET=replace-with-unique-model3d-secret-32bytes
MONITOR_SERVICE_CLIENT_SECRET=replace-with-unique-monitor-secret-32bytes
ORCHESTRATOR_SERVICE_CLIENT_SECRET=replace-with-unique-orchestrator-secret-32bytes
PORTAL_SERVICE_CLIENT_SECRET=replace-with-unique-portal-secret-32bytes
QUALITY_SERVICE_CLIENT_SECRET=replace-with-unique-quality-secret-32bytes
POINTCLOUD_WORKFLOW_SERVICE_CLIENT_SECRET=replace-with-unique-pointcloud-secret-32bytes
SERVICE_SERVICE_CLIENT_SECRET=replace-with-unique-service-secret-32bytes
STANDARD_SERVICE_CLIENT_SECRET=replace-with-unique-standard-secret-32bytes
SPARK_WORKFLOW_SERVICE_CLIENT_SECRET=replace-with-unique-spark-secret-32bytes
TRANSFER_SERVICE_CLIENT_SECRET=replace-with-unique-transfer-secret-32bytes

# Catalog 模块
CATALOG_BACKEND_PORT=8192
CATALOG_FE_PORT=5189
WORKBENCH_BACKEND_PORT=8193
WORKBENCH_FE_PORT=5190
CATALOG_SOURCE_SYNC_INTERVAL=30s
CATALOG_RESPONSIBILITY_RECONCILIATION_INTERVAL=5m

# Encryption Key（Base64 编码的 32 字节密钥）
# 生产环境由 scripts/prod/setup-env.sh 生成或由 Secret Manager 注入。
#
# 用途：加密 system.engines 表中的 connection_info 字段
# 使用密码学安全随机值生成
#
# 注意事项：
#   - 所有服务必须使用相同的 ENCRYPTION_KEY
#   - 密钥变更会导致已加密数据无法解密
#   - 生产环境务必安全保管此密钥
ENCRYPTION_KEY=

# ==================== 数据库配置 ====================
POSTGRES_USER=addp
POSTGRES_PASSWORD=addp_password          # ⚠️ 生产环境必须修改！
POSTGRES_DB=addp
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

# PostgreSQL 镜像（可选，默认使用远程镜像自动拉取）
# 如需使用本地镜像: POSTGRES_IMAGE=addp-postgres-pgvector:latest
POSTGRES_IMAGE=

# ==================== Redis 配置 ====================
# ⚠️ 必填项：docker-compose.infra.yml 不提供默认值
# 缓存和任务队列
REDIS_PASSWORD=addp_redis                # ⚠️ 生产环境必须修改！
REDIS_HOST=localhost
REDIS_PORT=16379

# ==================== Infra MinIO 配置 ====================
# ⚠️ 必填项：docker-compose.infra.yml 不提供默认值
# ADDP 基础设施级对象存储（用于系统文件、模块缓存、审计日志归档等）
# 不等于用户业务库对象存储；业务对象存储通过 System 引擎管理维护。
MINIO_ROOT_USER=minioadmin               # ⚠️ 生产环境必须修改！
MINIO_ROOT_PASSWORD=minioadmin           # ⚠️ 生产环境必须修改！
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_BUCKET=system

# 业务数据MinIO（用于存储用户上传的业务数据）
# 注意：业务MinIO独立部署在 business/docker-compose.yml 中
# 这些地址会保存到 system.engines，由 ADDP 容器内服务发起连接；
# 生产 Docker 部署默认通过 business_business-network 访问业务容器，不能使用 localhost。
BUSINESS_PG_HOST=business-postgres
BUSINESS_PG_PORT=5432
BUSINESS_PG_USER=business
BUSINESS_PG_PASSWORD=business_password
BUSINESS_PG_DB=business
BUSINESS_ORACLE_HOST=business-oracle
BUSINESS_ORACLE_PORT=1521
BUSINESS_ORACLE_SERVICE_NAME=FREEPDB1
BUSINESS_ORACLE_USER=business
BUSINESS_ORACLE_PASSWORD=business_oracle_password
BUSINESS_MINIO_ENDPOINT=business-minio:9000
BUSINESS_MINIO_ACCESS_KEY=minioadmin
BUSINESS_MINIO_SECRET_KEY=minioadmin

# ==================== Meilisearch 配置（全文检索） ====================
# Meilisearch 服务地址
MEILISEARCH_PORT=17700
MEILISEARCH_URL=http://localhost:17700
MEILISEARCH_URL_LOCAL=http://localhost:17700

# Meilisearch 主密钥（用于管理和搜索）
# ⚠️ 生产环境必须修改！建议至少 32 字符
MEILISEARCH_MASTER_KEY=your-master-key-change-in-production

# 索引名称：各 owner 独立管理，禁止跨模块复用
MEILISEARCH_MANAGER_CONTENT_INDEX=manager_content_documents
MEILISEARCH_CATALOG_INDEX=catalog_entries
CATALOG_PROJECTION_INTERVAL=2s

# ==================== Infra Kafka / Kafka Connect ====================
# ADDP 内部 CDC 基础设施，不注册为 System Engine，也不复用业务 Kafka 凭据。
REDPANDA_IMAGE=docker.redpanda.com/redpandadata/redpanda:v24.3.18
REDPANDA_MEMORY=1G
INFRA_KAFKA_PORT=19092
INFRA_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
INFRA_KAFKA_ADMIN_USERNAME=admin
INFRA_KAFKA_ADMIN_PASSWORD=addp_kafka_admin
INFRA_KAFKA_CONNECT_PASSWORD=addp_kafka_connect
INFRA_KAFKA_TRANSFER_PASSWORD=addp_kafka_transfer
INFRA_KAFKA_CDC_TOPIC_PREFIX=__addp_cdc.
INFRA_KAFKA_CDC_CONSUMER_GROUP_PREFIX=__addp_cdc_consumer.
INFRA_KAFKA_CDC_RETENTION=168h
# 生产环境必须按容量规划显式设置；任务级 CDC topic 由 Transfer capture supervisor 创建。
INFRA_KAFKA_CDC_RETENTION_BYTES=
INFRA_KAFKA_CDC_REPLICATION_FACTOR=1
INFRA_KAFKA_INTERNAL_REPLICATION_FACTOR=1
# Transfer-owned 业务 Kafka dead-letter payload topic；生产环境按坏记录峰值与审计窗口规划 bytes。
INFRA_KAFKA_DLQ_RETENTION=168h
INFRA_KAFKA_DLQ_RETENTION_BYTES=
INFRA_KAFKA_DLQ_REPLICATION_FACTOR=1
TRANSFER_DLQ_RECONCILE_INTERVAL=1m
TRANSFER_DLQ_RECONCILE_BATCH_SIZE=100
TRANSFER_DLQ_RECONCILE_TIMEOUT=10s
TRANSFER_DLQ_RECONCILE_FETCH_MAX_BYTES=10485760
INFRA_KAFKA_SECURITY_PROTOCOL=sasl_plaintext
INFRA_KAFKA_SASL_MECHANISM=scram-sha-256
INFRA_KAFKA_TLS_CA_CERT_FILE=
INFRA_KAFKA_TLS_INSECURE_SKIP_VERIFY=false
INFRA_KAFKA_DISK_DEGRADED_PERCENT=75
INFRA_KAFKA_DISK_CRITICAL_PERCENT=85
# 生产 HA profile 使用；默认单机 Infra 启动不读取。
REDPANDA_HA_MEMORY=1G
REDPANDA_HA_KAFKA_2_PORT=19093
REDPANDA_HA_KAFKA_3_PORT=19094

KAFKA_CONNECT_IMAGE=quay.io/debezium/connect:3.6.0.Final
KAFKA_CONNECT_PORT=18083
KAFKA_CONNECT_URL=http://localhost:18083
KAFKA_CONNECT_USERNAME=
KAFKA_CONNECT_PASSWORD=
KAFKA_CONNECT_TIMEOUT=15s
KAFKA_CONNECT_LOOPBACK_HOST=host.docker.internal
KAFKA_CONNECT_BOOTSTRAP_SERVERS=redpanda:29092
KAFKA_CONNECT_KAFKA_USERNAME=connect
KAFKA_CONNECT_KAFKA_SECURITY_PROTOCOL=sasl_plaintext
KAFKA_CONNECT_KAFKA_TLS_CA_CERT_FILE=
KAFKA_CONNECT_GROUP_ID=addp-connect-cluster
KAFKA_CONNECT_CONFIG_TOPIC=__addp_connect_configs
KAFKA_CONNECT_OFFSET_TOPIC=__addp_connect_offsets
KAFKA_CONNECT_STATUS_TOPIC=__addp_connect_status
KAFKA_CONNECT_HEAP_OPTS="-Xms512m -Xmx512m"
TRANSFER_CAPTURE_PROVISIONING_TIMEOUT=60s
TRANSFER_CAPTURE_STATUS_POLL_INTERVAL=1s
TRANSFER_CAPTURE_MONITOR_INTERVAL=15s
TRANSFER_CONTINUOUS_RUNTIME_STOP_TIMEOUT=45s
TRANSFER_CONTINUOUS_RUNTIME_STOP_POLL_INTERVAL=250ms
TRANSFER_META_SCAN_CLAIM_TTL=2m
# ==================== Docker Compose 配置 ====================
# Monitor 将公共 execution metadata 中的观测信号物化为告警事件的周期。
# Webhook outbox dispatcher 的轮询、HTTP 超时、领取租约和重试策略。
# 默认只允许 HTTPS 公网目标；本地/受管内网联调时才显式开启。
MONITOR_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# Webhook payload 中生成告警详情链接使用的 Console 外部地址。
MONITOR_CONSOLE_BASE_URL=http://localhost:5170

# 容器命名前缀（用于区分不同环境）
# ⚠️ Docker Compose 使用，设置后容器名为 ${COMPOSE_PROJECT_NAME}-service-name
# 注意: docker-compose.yml 已显式设置 name: addp-app，优先级高于此变量
# COMPOSE_PROJECT_NAME=addp-app

# Nginx 统一网关端口
NGINX_PORT=80

# Console 工作台独立访问端口（开发调试用）
CONSOLE_PORT=5170

# 镜像仓库和标签
REGISTRY=localhost:5001
IMAGE_TAG=latest

# ==================== 本地开发服务端口 ====================
SERVICE_HOST=localhost
GATEWAY_PORT=8000
SYSTEM_BACKEND_PORT=8180
MANAGER_BACKEND_PORT=8081
META_BACKEND_PORT=8082
TRANSFER_BACKEND_PORT=8083
ORCHESTRATOR_BACKEND_PORT=8084
DEVELOP_BACKEND_PORT=8185
INFERENCE_BACKEND_PORT=8191
# Inference 就绪后自行注册 Runtime Engine Instance；业务调用方通过 Runtime Descriptor 发现端点。
SERVICE_BACKEND_PORT=8086
COPILOT_BACKEND_PORT=8087
MONITOR_BACKEND_PORT=8100
STANDARD_BACKEND_PORT=8110
STANDARD_DOCUMENT_MAX_FILE_SIZE=104857600
STANDARD_DOCUMENT_STORAGE_TIMEOUT=30s
MODEL_BACKEND_PORT=8181
QUALITY_BACKEND_PORT=8182
QUALITY_CHECK_TIMEOUT=30m
QUALITY_WORKER_CONCURRENCY=4
QUALITY_WORKER_LEASE_DURATION=30m
QUALITY_WORKER_POLL_INTERVAL=500ms
ASSET_BACKEND_PORT=8183
PORTAL_BACKEND_PORT=8184
AGENT_BACKEND_PORT=8190
GRAPH_BACKEND_PORT=8186

# 工作流与查询引擎
MATH_WORKFLOW_PORT=8089
JUPYTER_API_PORT=8097
SPARK_WORKFLOW_PORT=8098
GEOPYTHON_WORKFLOW_PORT=8099
GEOPYTHON_WORKFLOW_GUNICORN_TIMEOUT=7200
MODEL3D_WORKFLOW_PORT=8101
POINTCLOUD_WORKFLOW_PORT=8102
SUPERMAP_WORKFLOW_PORT=8103
RASTER_MOSAIC_RUNTIME_PORT=8291

# ==================== Manager 模块配置 ====================
# Manager 通过顶部统一 META_URL 查询元数据。

# Manager 向量化配置（按需触发）

# Worker 容量与重试等待属于部署配置，不在配置管理页面中修改。
TRANSFER_BOUNDED_WORKER_CONCURRENCY=10
TRANSFER_BOUNDED_LEASE_DURATION=2m
TRANSFER_BOUNDED_HEARTBEAT_INTERVAL=30s
TRANSFER_BOUNDED_CLAIM_INTERVAL=1s
DEVELOP_QUERY_WORKER_CONCURRENCY=4
DEVELOP_QUERY_LEASE_SECONDS=120
DEVELOP_QUERY_HEARTBEAT_SECONDS=30
DEVELOP_QUERY_CLAIM_INTERVAL_SECONDS=1
META_WORKER_CONCURRENCY=10
META_BOUNDED_LEASE_DURATION=2m
META_BOUNDED_HEARTBEAT_INTERVAL=30s
META_BOUNDED_CLAIM_INTERVAL=1s

# SpatiaLite 扩展配置（用于读取 SpatiaLite 数据库）
# 说明：Transfer 模块支持从 SpatiaLite 数据库导入空间数据
# 如不指定，系统会自动检测以下路径：
#   - macOS ARM: /opt/homebrew/lib/mod_spatialite.dylib
#   - macOS Intel: /usr/local/lib/mod_spatialite.dylib
#   - Linux: /usr/lib/x86_64-linux-gnu/mod_spatialite.so
# 仅在自动检测失败或需要使用自定义路径时设置
# SPATIALITE_EXTENSION_PATH=/opt/homebrew/lib/mod_spatialite.dylib

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_FORMAT=json

# ==================== 环境 ====================
ENV=development
TZ=Asia/Shanghai
# PROJECT_ROOT 由启动脚本自动设置，仅在绕过标准启动脚本时手动配置。

# ==================== 专用 Online T4 Runner（仅写入仓库外环境文件） ====================
# 以下是字段清单，不应直接启用在开发 .env中。
# ADDP_ONLINE_TEST=1
# ADDP_ONLINE_TEST_TENANT_ID=
# POSTGRES_DB=addp_online
# ADDP_ONLINE_TEST_USER_ACCESS_TOKEN=
# ADDP_ONLINE_TEST_USER_USERNAME=
# ADDP_ONLINE_TEST_USER_PASSWORD=
# ADDP_ONLINE_TEST_ENGINE_ID=
# ADDP_ONLINE_TEST_ENGINE_NAME=
# ADDP_ONLINE_TEST_ENGINE_PORT=
# ADDP_ONLINE_TEST_ENGINE_USER=
# ADDP_ONLINE_TEST_ENGINE_PASSWORD=
# ADDP_ONLINE_TEST_ENGINE_DATABASE=
# enterprise-catalog-publishing 使用的永久 Standard Domain 和 Department 身份。
# ADDP_ONLINE_TEST_CATALOG_DOMAIN_ID=
# ADDP_ONLINE_TEST_CATALOG_DEPARTMENT_ID=
# ADDP_ONLINE_WORKBENCH_MYSQL_ENGINE_ID=
