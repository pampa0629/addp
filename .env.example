# ADDP_ONLINE_WORKBENCH_MYSQL_DATABASE=commerce_fixture
# ADDP_ONLINE_WORKBENCH_MYSQL_USER=workbench_reader
# ADDP_ONLINE_WORKBENCH_MYSQL_PASSWORD=
# ADDP_ONLINE_WORKBENCH_MYSQL_ROOT_PASSWORD=
# ADDP_ONLINE_CATALOG_CONVERGENCE_TIMEOUT_SECONDS=180

# ==================== Go 模块下载网络配置（可选） ====================
# 避免开发环境无法访问 proxy.golang.org 时 go run 超时
# 如在中国大陆网络，建议启用：
# GOPROXY=https://goproxy.cn,direct
# GOSUMDB=sum.golang.org
