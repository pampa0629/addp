# ==================== 全域数据平台配置示例 ====================
# 复制此文件为 .env 并修改配置

# ==================== System 模块配置 ====================

# 超级管理员配置（首次启动时自动创建）
# ⚠️ 生产环境必须修改默认密码！
#
# 用途：系统首次启动时，如果数据库中没有超级管理员，会自动创建
# 注意事项：
#   - 创建后修改环境变量不会更新已存在的用户
#   - 如需修改密码，请通过系统管理界面操作
#   - 密码建议至少 12 字符，包含大小写字母、数字和特殊字符
SUPER_ADMIN_USERNAME=SuperAdmin
SUPER_ADMIN_PASSWORD=20251001#SuperAdmin
SUPER_ADMIN_EMAIL=superadmin@addp.com

# ==================== 默认租户配置 (仅用于开发环境) ====================
# 是否在应用启动时自动创建默认租户和管理员账户
# ⚠️ 仅在开发环境使用,生产环境强制禁用
# ⚠️ 默认值为 false,需要显式启用
ENABLE_DEFAULT_TENANT=true

# 默认租户信息
DEFAULT_TENANT_NAME=默认租户
DEFAULT_TENANT_DESCRIPTION=用于开发和测试的默认租户

# 默认租户管理员账户
# ⚠️ 此账户仅用于开发调试,密码简单便于记忆
# ⚠️ 生产环境不应创建此账户
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=123456
DEFAULT_ADMIN_EMAIL=admin@addp.com

# JWT Secret（用于签名用户认证 Token）
# ⚠️ 生产环境必须修改！建议至少 64 字符（512 bits）
# ⚠️ 密钥长度必须 >= 32 字符，否则服务拒绝启动
#
# 安全密钥生成方法（任选一种）：
#   方法 1 (推荐): openssl rand -base64 64
#   方法 2: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   方法 3: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
#
# 注意事项：
#   - 切勿使用字典词汇或简单字符串
#   - 生产环境禁止使用包含 "change-this" 或 "change-in-production" 的默认值
#   - 所有服务必须使用相同的 JWT_SECRET
#   - 密钥泄露需立即更换并强制所有用户重新登录
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Token 过期时间（单位：分钟）
# 默认值：180 分钟（3小时）
# 说明：用户登录后 Token 的有效期，过期后需要重新登录
JWT_EXPIRE_MINUTES=180

# CORS 允许的来源（跨域资源共享白名单）
# ⚠️ 生产环境必须配置为实际前端域名！
#
# 用途：控制哪些前端域名可以访问 API，提高安全性
# 格式：逗号分隔的 URL 列表，不包含路径和尾部斜杠
#
# 示例：
#   开发环境: http://localhost:5170,http://localhost:5173
#   生产环境: https://app.example.com,https://www.example.com
#
# 注意事项：
#   - 不要使用通配符 "*"（不安全）
#   - 必须包含协议（http:// 或 https://）
#   - 端口号必须精确匹配
#   - 多个域名用英文逗号分隔，逗号后可有空格
ALLOWED_ORIGINS=http://localhost:5170,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Internal API Key（用于服务间通信认证）
# ⚠️ 生产环境必须修改！建议至少 32 字符
#
# 用途：Manager/Meta 等服务调用 System 的 /internal/* 接口时验证身份
# 生成方法同 JWT_SECRET
#
# 注意事项：
#   - 仅用于内部服务间调用，不对外暴露
#   - 所有服务必须使用相同的 INTERNAL_API_KEY
#   - 与 JWT_SECRET 应使用不同的密钥
INTERNAL_API_KEY=dev-internal-key

# Encryption Key（用于加密敏感数据，如数据库密码）
# ⚠️ 生产环境必须修改！建议至少 32 字符
#
# 用途：加密 system.engines 表中的 connection_info 字段
# 生成方法同 JWT_SECRET
#
# 注意事项：
#   - 所有服务必须使用相同的 ENCRYPTION_KEY
#   - 密钥变更会导致已加密数据无法解密
#   - 生产环境务必安全保管此密钥
ENCRYPTION_KEY=your-encryption-key-change-this-in-production

# ==================== 数据库配置 ====================
POSTGRES_USER=addp
POSTGRES_PASSWORD=addp_password          # ⚠️ 生产环境必须修改！
POSTGRES_DB=addp
POSTGRES_HOST=postgres
POSTGRES_PORT=15432

# PostgreSQL 镜像（可选，默认使用远程镜像自动拉取）
# 如需使用本地镜像: POSTGRES_IMAGE=addp-postgres-pgvector:latest

# ==================== Redis 配置 ====================
# ⚠️ 必填项：docker-compose.infra.yml 不提供默认值
# 缓存和任务队列
REDIS_PASSWORD=addp_redis                # ⚠️ 生产环境必须修改！
REDIS_HOST=redis
REDIS_PORT=16379

# ==================== MinIO 配置 ====================
# ⚠️ 必填项：docker-compose.infra.yml 不提供默认值
# ADDP系统MinIO（用于存储系统文件，如用户头像、系统配置等）
MINIO_ROOT_USER=minioadmin               # ⚠️ 生产环境必须修改！
MINIO_ROOT_PASSWORD=minioadmin           # ⚠️ 生产环境必须修改！
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_BUCKET=addp-data

# 业务数据MinIO（用于存储用户上传的业务数据）
# 注意：业务MinIO独立部署在 business/docker-compose.yml 中
# 这些地址会保存到 system.engines，由 ADDP 容器内服务发起连接；
# 生产 Docker 部署默认通过 business_business-network 访问业务容器，不能使用 localhost。
BUSINESS_PG_HOST=business-postgres
BUSINESS_PG_PORT=5432
BUSINESS_PG_USER=business
BUSINESS_PG_PASSWORD=business_password
BUSINESS_PG_DB=business
BUSINESS_MINIO_ENDPOINT=business-minio:9000
BUSINESS_MINIO_ACCESS_KEY=minioadmin
BUSINESS_MINIO_SECRET_KEY=minioadmin

# ==================== Meilisearch 配置（全文检索） ====================
# Meilisearch 服务地址
MEILISEARCH_PORT=17700
MEILISEARCH_URL=http://meilisearch:17700
MEILISEARCH_URL_LOCAL=http://localhost:17700

# Meilisearch 主密钥（用于管理和搜索）
# ⚠️ 生产环境必须修改！建议至少 32 字符
MEILISEARCH_MASTER_KEY=your-master-key-change-in-production

# 索引名称
# 统一资产索引（跨模块共享，存储所有资产：表、文件、文档等）
MEILISEARCH_ASSET_INDEX=assets

# ==================== Docker Compose 配置 ====================
# 容器命名前缀（用于区分不同环境）
# ⚠️ Docker Compose 使用，设置后容器名为 ${COMPOSE_PROJECT_NAME}-service-name
# 注意: docker-compose.yml 已显式设置 name: addp-app，优先级高于此变量
# COMPOSE_PROJECT_NAME=addp-app

# Nginx 统一网关端口
NGINX_PORT=80

# Console 工作台独立访问端口（开发调试用）
CONSOLE_PORT=5170

# 镜像仓库和标签
REGISTRY=localhost:5001
IMAGE_TAG=latest

# ==================== 服务端口配置 ====================
# Gateway
GATEWAY_PORT=8000

# System
SYSTEM_BACKEND_PORT=8180  # 避免与企业微信等应用的8080端口冲突
SERVER_ADDR=:8180          # System Backend 实际使用的环境变量
SYSTEM_FRONTEND_PORT=8090

# Manager
MANAGER_BACKEND_PORT=8081
MANAGER_FRONTEND_PORT=8091
# Manager 上传导入 Shapefile 时使用的中转对象存储 engine id。
# 留空时 Manager 会按 MINIO_SYSTEM_ENDPOINT / bucket / access key 在 System 对象存储引擎中自动匹配。
MANAGER_IMPORT_SOURCE_ENGINE_ID=

# Meta
META_BACKEND_PORT=8082
META_FRONTEND_PORT=8092

# Transfer
TRANSFER_BACKEND_PORT=8083
TRANSFER_FRONTEND_PORT=8093

# Orchestrator
ORCHESTRATOR_BACKEND_PORT=8084
ORCHESTRATOR_FRONTEND_PORT=8094

# Quality
QUALITY_BACKEND_PORT=8182
QUALITY_FRONTEND_PORT=5183
QUALITY_URL=http://localhost:8182

# Agent
AGENT_BACKEND_PORT=8190

# Graph 知识图谱模块
GRAPH_BACKEND_PORT=8186
GRAPH_FRONTEND_PORT=5187
GRAPH_URL=http://localhost:8186

# ==================== 服务间调用配置 ====================
ENABLE_SERVICE_INTEGRATION=true
SERVICE_CALL_TIMEOUT=30s

# ==================== Manager 模块配置 ====================
STORAGE_TYPE=minio
PREVIEW_MAX_ROWS=1000
PREVIEW_MAX_SIZE_MB=100

# Meta Integration（Manager 通过 Meta API 查询元数据）
META_URL=http://localhost:8082
ENABLE_META_INTEGRATION=true

# Manager 向量化配置（按需触发）
MANAGER_EMBEDDING_SERVICE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
MANAGER_EMBEDDING_SERVICE_API_KEY=
MANAGER_EMBEDDING_SERVICE_TIMEOUT=15s
MANAGER_EMBEDDING_MODEL=qwen2.5-vl-embedding
MANAGER_VECTOR_DIMENSION=1024
MANAGER_VECTOR_SEARCH_MAX_DISTANCE=0.35
MANAGER_VECTOR_MAX_FILE_SIZE_MB=10
MANAGER_VECTOR_BATCH_CONCURRENCY=5

# ==================== Meta 模块配置 ====================
PARSER_SAMPLE_SIZE=10000
PARSER_TIMEOUT=300s

# ==================== Transfer 模块配置 ====================
# Worker 配置
WORKER_COUNT=5                      # Worker 进程数量
CONCURRENT_TASKS=10                 # 并发任务数量

# 任务队列配置
TASK_QUEUE_NAME=transfer:tasks      # Redis 任务队列名称

# 重试配置
MAX_RETRIES=3                       # 最大重试次数
RETRY_DELAY=30s                     # 重试延迟（支持单位: s, m, h）

# 性能配置（可选）
DEFAULT_BATCH_SIZE=1000             # 默认批处理大小
TASK_TIMEOUT=3600s                  # 任务执行超时时间

# SpatiaLite 扩展配置（用于读取 SpatiaLite 数据库）
# 说明：Transfer 模块支持从 SpatiaLite 数据库导入空间数据
# 如不指定，系统会自动检测以下路径：
#   - macOS ARM: /opt/homebrew/lib/mod_spatialite.dylib
#   - macOS Intel: /usr/local/lib/mod_spatialite.dylib
#   - Linux: /usr/lib/x86_64-linux-gnu/mod_spatialite.so
# 仅在自动检测失败或需要使用自定义路径时设置
# SPATIALITE_EXTENSION_PATH=/opt/homebrew/lib/mod_spatialite.dylib

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_FORMAT=json

# ==================== 环境 ====================
ENV=development
PROJECT_ROOT=/absolute/path/to/addp

# ==================== Go 模块下载网络配置（可选） ====================
# 避免开发环境无法访问 proxy.golang.org 时 go run 超时
# 如在中国大陆网络，建议启用：
# GOPROXY=https://goproxy.cn,direct
# GOSUMDB=sum.golang.org
