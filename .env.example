# ==================== 全域数据平台配置示例 ====================
# 复制此文件为 .env 并修改配置

# ==================== System 模块配置 ====================

# JWT Secret（用于签名用户认证 Token）
# ⚠️ 生产环境必须修改！建议至少 64 字符（512 bits）
# ⚠️ 密钥长度必须 >= 32 字符，否则服务拒绝启动
#
# 安全密钥生成方法（任选一种）：
#   方法 1 (推荐): openssl rand -base64 64
#   方法 2: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   方法 3: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
#
# 注意事项：
#   - 切勿使用字典词汇或简单字符串
#   - 生产环境禁止使用包含 "change-this" 或 "change-in-production" 的默认值
#   - 所有服务必须使用相同的 JWT_SECRET
#   - 密钥泄露需立即更换并强制所有用户重新登录
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Internal API Key（用于服务间通信认证）
# ⚠️ 生产环境必须修改！建议至少 32 字符
#
# 用途：Manager/Meta 等服务调用 System 的 /internal/* 接口时验证身份
# 生成方法同 JWT_SECRET
#
# 注意事项：
#   - 仅用于内部服务间调用，不对外暴露
#   - 所有服务必须使用相同的 INTERNAL_API_KEY
#   - 与 JWT_SECRET 应使用不同的密钥
INTERNAL_API_KEY=dev-internal-key

# ==================== 数据库配置 ====================
POSTGRES_USER=addp
POSTGRES_PASSWORD=addp_password
POSTGRES_DB=addp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==================== Redis 配置 ====================
REDIS_PASSWORD=addp_redis
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== MinIO 配置 ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=addp-data

# ==================== 服务端口配置 ====================
# Gateway
GATEWAY_PORT=8000

# System
SYSTEM_BACKEND_PORT=8080
SYSTEM_FRONTEND_PORT=8090

# Manager
MANAGER_BACKEND_PORT=8081
MANAGER_FRONTEND_PORT=8091

# Meta
META_BACKEND_PORT=8082
META_FRONTEND_PORT=8092

# Transfer
TRANSFER_BACKEND_PORT=8083
TRANSFER_FRONTEND_PORT=8093

# ==================== 服务间调用配置 ====================
ENABLE_SERVICE_INTEGRATION=true
SERVICE_CALL_TIMEOUT=30s

# ==================== Manager 模块配置 ====================
STORAGE_TYPE=minio
PREVIEW_MAX_ROWS=1000
PREVIEW_MAX_SIZE_MB=100

# ==================== Meta 模块配置 ====================
PARSER_SAMPLE_SIZE=10000
PARSER_TIMEOUT=300s

# ==================== Transfer 模块配置 ====================
WORKER_CONCURRENCY=10
TRANSFER_BATCH_SIZE=1000
TRANSFER_TIMEOUT=3600s
TRANSFER_MAX_RETRY=3

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_FORMAT=json

# ==================== 环境 ====================
ENV=development
PROJECT_ROOT=/absolute/path/to/addp
