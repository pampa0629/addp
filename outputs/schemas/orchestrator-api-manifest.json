{
  "module": "orchestrator",
  "title": "工作流编排模块",
  "version": "0.0.20",
  "categories": [
    {
      "name": "工作流编排",
      "description": "工作流 DAG 管理、任务调度、执行监控",
      "apis": [
        {
          "name": "创建编排任务",
          "method": "POST",
          "path": "/api/orchestrator/orchestrations",
          "description": "创建新的工作流编排任务（DAG）",
          "auth": true,
          "request": "{\n  \"name\": \"每日数据处理流程\",\n  \"dag_definition\": {...},\n  \"schedule\": \"0 2 * * *\",\n  \"enabled\": true\n}",
          "response": "{\n  \"orchestration_id\": 123,\n  \"status\": \"created\",\n  \"message\": \"编排任务创建成功\"\n}"
        },
        {
          "name": "获取编排列表",
          "method": "GET",
          "path": "/api/orchestrator/orchestrations",
          "description": "获取工作流编排任务列表",
          "auth": true,
          "query": "page: 页码，默认 1\npage_size: 每页数量，默认 20\nstatus: 状态筛选（可选：enabled、disabled）",
          "response": "[\n  {\n    \"id\": 123,\n    \"name\": \"每日数据处理流程\",\n    \"schedule\": \"0 2 * * *\",\n    \"enabled\": true,\n    \"last_run\": \"2025-12-30T02:00:00Z\"\n  }\n]"
        },
        {
          "name": "触发编排执行",
          "method": "POST",
          "path": "/api/orchestrator/orchestrations/:id/trigger",
          "description": "手动触发编排任务执行",
          "auth": true,
          "params": ":id - 编排任务ID",
          "response": "{\n  \"execution_id\": \"exec_456\",\n  \"status\": \"running\",\n  \"message\": \"编排任务已启动\"\n}"
        },
        {
          "name": "获取执行记录",
          "method": "GET",
          "path": "/api/orchestrator/executions",
          "description": "获取编排任务的执行记录",
          "auth": true,
          "query": "orchestration_id: 编排任务ID（可选）\npage: 页码，默认 1\npage_size: 每页数量，默认 20",
          "response": "[\n  {\n    \"execution_id\": \"exec_456\",\n    \"orchestration_id\": 123,\n    \"status\": \"success\",\n    \"started_at\": \"2025-12-30T02:00:00Z\",\n    \"finished_at\": \"2025-12-30T02:15:23Z\"\n  }\n]"
        }
      ]
    }
  ]
}
