{
  "name": "builtin:content-sqlite",
  "type": "builtin",
  "builtin": "sqlite",
  "priority": 58,
  "max_bytes": 1073741824,
  "match": {
    "extensions": [".sqlite", ".sqlite3", ".db"],
    "content_types": [
      "application/x-sqlite3",
      "application/sqlite",
      "application/octet-stream"
    ]
  },
  "metadata": {
    "table_limit": 10,
    "row_limit": 50,
    "_comment": "使用流式处理，支持大文件 SQLite 预览（最大 1GB），仅传输表元数据和示例数据到前端"
  }
}
