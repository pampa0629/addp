FROM localhost:5001/ubuntu:24.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates tzdata && rm -rf /var/lib/apt/lists/*

# Build arguments for precise binary selection
ARG BUILD_ARCH=amd64
ARG BUILD_TYPE=release
ARG GOOS=linux

WORKDIR /app

# 复制本地编译好的二进制文件（从扁平化 dist/ 目录）
# 路径: dist/{build}-{os}-{arch}/manager
COPY dist/${BUILD_TYPE}-${GOOS}-${BUILD_ARCH}/manager ./server
COPY manager/backend/plugins ./manager/backend/plugins
RUN chmod +x ./server

ENV PROJECT_ROOT=/app

# 暴露端口
EXPOSE 8081

# 运行
CMD ["./server"]
